#!/usr/bin/env bash
# Full rspec suite in parallel, one database per process (storage/testN.sqlite3).
# Files are split by the runtime each took last run (tmp/parallel_runtime_rspec.log).
# Databases: bin/setup creates them (parallel:create[8] parallel:load_schema[8]).
# 8 processes, measured on 12 cores (serial bundle exec rspec: 190 s warm), two runs each,
# after splitting the slowest system spec files (2026-11-12):
#   -n 4: 44, 45 s   -n 6: 37, 37 s   -n 8: 38, 42 s   -n 10: 48, 54 s
# 8 is kept: level with 6 within the noise, and the count every app uses. 10 saturates the CPU.
# With every file split under 8 s at -n 8: 36-41 s. Under 8 processes a file flaps 1-2 s around
# the limit from run to run: split a file the warning names run after run, not once.
# A smaller count passes through: bin/test-all -n 4 (CI's 4-core runner).
# Extra arguments pass through; spec paths run those alone and leave the runtime log as it was.
# Ends with the combined "N examples, M failures" line; exits non-zero on a failure.
set -o pipefail
cd "$(dirname "$0")/.."

out=$(mktemp)
trap 'rm -f "$out"' EXIT

# The whole spec folder unless an argument names a spec path: then only those.
target=spec
for arg in "$@"; do case "$arg" in spec | spec/*) target= ;; esac; done

# A partial run would rewrite the runtime log with its files alone: keep the full run's.
log=tmp/parallel_runtime_rspec.log
[ -z "$target" ] && [ -f "$log" ] && cp "$log" "$log.full"
# The last full run's times, for the slow-file rule below.
[ -n "$target" ] && [ -f "$log" ] && cp "$log" "$log.prev"
# Busy: under half the CPU idle in a 1 s sample before the run. Not the load average, which counts idle VM threads. CI never checks.
if [ -n "$CI" ]; then busy=1; idle=CI; else
  idle=$(top -l 2 -s 1 -n 0 | awk '/CPU usage/ { i = $7 } END { sub("%", "", i); print int(i) }')
  busy=$([ "${idle:-0}" -lt 50 ] && echo 1 || echo 0)
fi

bundle exec parallel_rspec $target -n 8 --serialize-stdout --combine-stderr \
  --runtime-log "$log" "$@" | tee "$out"
status=$?

[ -z "$target" ] && [ -f "$log.full" ] && mv "$log.full" "$log"

# Named only when over it in this full run and the one before: one run's time swings with load.
# A file it names sets the floor for the whole run: split it by describe group.
[ -n "$target" ] && [ "$busy" = 1 ] && echo "Machine busy (CPU ${idle}% idle): spec file times not checked."
[ -n "$target" ] && [ "$busy" = 0 ] && [ -f "$log.prev" ] && awk -F: -v limit=8 '
  NR == FNR { if ($2 > limit) prev[$1] = $2; next }
  $2 > limit && ($1 in prev) { printf "Slow spec file: %s took %.1f s and %.1f s in the last two full runs, over the %d s limit. Split it by describe group.\n", $1, prev[$1], $2, limit }' \
  "$log.prev" "$log" 2>/dev/null

summary=$(grep -E '^[0-9]+ examples?, [0-9]+ failures?' "$out" | tail -1)
echo "${summary:-no combined summary: the run did not finish}"
[ -n "$summary" ] || [ "$status" -ne 0 ] || status=1
exit "$status"
