# Secrets referenced by config/deploy.yml. Kamal runs the command substitutions
# below at deploy time, so no value is stored here (docs/deploy.md). DO NOT
# ENTER RAW CREDENTIALS HERE! This file is committed.
#
# The Keychain items are created once, see docs/deploy.md. This ties a deploy to
# a Mac, which is fine while deploys are run by hand from one laptop.

KAMAL_REGISTRY_PASSWORD=$(security find-generic-password -w -s onset-registry-pat)
SENTRY_DSN=$(security find-generic-password -w -s onset-sentry-dsn)
RAILS_MASTER_KEY=$(cat config/master.key)
