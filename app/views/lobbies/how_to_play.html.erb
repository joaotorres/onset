<% content_for :head, canonical_link(how_to_play_path) %>
<% content_for :title, "How to play · Onset" %>

<main class="grow bg-gray-950 text-white light:bg-gray-50 light:text-gray-900">
  <div class="px-5 pt-6 pb-16 sm:px-8 md:pt-10 md:pb-24 lg:px-10">
  <div class="mx-auto max-w-[944px]">
    <nav class="flex items-center justify-between">
      <%= link_to "← Back", @back_path, class: "inline-flex min-h-11 items-center text-sm font-semibold text-gray-300 hover:text-white light:text-gray-700 light:hover:text-gray-900" %>
      <div class="flex items-center gap-3">
        <%= link_to "Onset", root_path, class: "font-display text-xl font-extrabold tracking-tight" %>
        <%= render "layouts/settings" %>
      </div>
    </nav>

    <header class="mt-10 md:mt-16">
      <p class="text-sm uppercase tracking-widest text-gray-400 light:text-gray-600">How to play</p>
      <h1 class="mt-3 font-display text-5xl font-extrabold leading-[1.05] tracking-tight md:text-7xl">Find three cards that make a Set.</h1>
      <p class="mt-5 max-w-[65ch] text-lg text-gray-300 md:text-xl light:text-gray-700">Onset is the card game Set, played live. Everyone plays on their own phone or computer, sees the same cards and races to spot a Set. A big screen the whole table can see is optional.</p>
    </header>

    <section class="mt-16 md:mt-24">
      <h2 class="font-display text-3xl font-bold md:text-4xl">Every card has four features</h2>
      <p class="mt-3 max-w-[65ch] text-gray-400 md:text-lg light:text-gray-600">Each feature comes in three versions, which makes 81 different cards.</p>
      <div class="mt-8 grid gap-4 md:grid-cols-2 md:gap-6">
        <div class="rounded-3xl bg-gray-900 p-5 md:p-6 light:bg-white light:shadow-[inset_0_0_0_1px_var(--color-gray-200)]">
          <h3 class="text-sm font-semibold uppercase tracking-widest text-gray-400 light:text-gray-600">Number</h3>
          <div class="mt-4 grid grid-cols-3 gap-3 md:gap-4">
            <figure class="flex flex-col items-center gap-2"><div class="card-edge h-28 aspect-[5/7] md:h-36"><%= example_card(0, 0, 0, 0) %></div><figcaption class="text-sm text-gray-300 light:text-gray-700">1</figcaption></figure>
            <figure class="flex flex-col items-center gap-2"><div class="card-edge h-28 aspect-[5/7] md:h-36"><%= example_card(1, 0, 0, 0) %></div><figcaption class="text-sm text-gray-300 light:text-gray-700">2</figcaption></figure>
            <figure class="flex flex-col items-center gap-2"><div class="card-edge h-28 aspect-[5/7] md:h-36"><%= example_card(2, 0, 0, 0) %></div><figcaption class="text-sm text-gray-300 light:text-gray-700">3</figcaption></figure>
          </div>
        </div>
        <div class="rounded-3xl bg-gray-900 p-5 md:p-6 light:bg-white light:shadow-[inset_0_0_0_1px_var(--color-gray-200)]">
          <h3 class="text-sm font-semibold uppercase tracking-widest text-gray-400 light:text-gray-600">Shape</h3>
          <div class="mt-4 grid grid-cols-3 gap-3 md:gap-4">
            <figure class="flex flex-col items-center gap-2"><div class="card-edge h-28 aspect-[5/7] md:h-36"><%= example_card(1, 0, 0, 1) %></div><figcaption class="text-sm text-gray-300 light:text-gray-700">oval</figcaption></figure>
            <figure class="flex flex-col items-center gap-2"><div class="card-edge h-28 aspect-[5/7] md:h-36"><%= example_card(1, 1, 0, 1) %></div><figcaption class="text-sm text-gray-300 light:text-gray-700">squiggle</figcaption></figure>
            <figure class="flex flex-col items-center gap-2"><div class="card-edge h-28 aspect-[5/7] md:h-36"><%= example_card(1, 2, 0, 1) %></div><figcaption class="text-sm text-gray-300 light:text-gray-700">diamond</figcaption></figure>
          </div>
        </div>
        <div class="rounded-3xl bg-gray-900 p-5 md:p-6 light:bg-white light:shadow-[inset_0_0_0_1px_var(--color-gray-200)]">
          <h3 class="text-sm font-semibold uppercase tracking-widest text-gray-400 light:text-gray-600">Shading</h3>
          <div class="mt-4 grid grid-cols-3 gap-3 md:gap-4">
            <figure class="flex flex-col items-center gap-2"><div class="card-edge h-28 aspect-[5/7] md:h-36"><%= example_card(1, 2, 0, 2) %></div><figcaption class="text-sm text-gray-300 light:text-gray-700">solid</figcaption></figure>
            <figure class="flex flex-col items-center gap-2"><div class="card-edge h-28 aspect-[5/7] md:h-36"><%= example_card(1, 2, 1, 2) %></div><figcaption class="text-sm text-gray-300 light:text-gray-700">striped</figcaption></figure>
            <figure class="flex flex-col items-center gap-2"><div class="card-edge h-28 aspect-[5/7] md:h-36"><%= example_card(1, 2, 2, 2) %></div><figcaption class="text-sm text-gray-300 light:text-gray-700">outline</figcaption></figure>
          </div>
        </div>
        <div class="rounded-3xl bg-gray-900 p-5 md:p-6 light:bg-white light:shadow-[inset_0_0_0_1px_var(--color-gray-200)]">
          <h3 class="text-sm font-semibold uppercase tracking-widest text-gray-400 light:text-gray-600">Color</h3>
          <div class="mt-4 grid grid-cols-3 gap-3 md:gap-4">
            <figure class="flex flex-col items-center gap-2"><div class="card-edge h-28 aspect-[5/7] md:h-36"><%= example_card(1, 1, 1, 0) %></div><figcaption class="text-sm text-gray-300 light:text-gray-700">blue</figcaption></figure>
            <figure class="flex flex-col items-center gap-2"><div class="card-edge h-28 aspect-[5/7] md:h-36"><%= example_card(1, 1, 1, 1) %></div><figcaption class="text-sm text-gray-300 light:text-gray-700">orange</figcaption></figure>
            <figure class="flex flex-col items-center gap-2"><div class="card-edge h-28 aspect-[5/7] md:h-36"><%= example_card(1, 1, 1, 2) %></div><figcaption class="text-sm text-gray-300 light:text-gray-700">magenta</figcaption></figure>
          </div>
        </div>
      </div>
    </section>

    <section class="mt-16 md:mt-24">
      <h2 class="font-display text-3xl font-bold md:text-4xl">What makes a Set</h2>
      <p class="mt-4 max-w-[65ch] font-display text-2xl font-bold leading-snug md:text-3xl">Three cards where each feature is either <span class="text-green-400 light:text-green-700">all the same</span> or <span class="text-green-400 light:text-green-700">all different</span>.</p>
      <div class="mt-8 grid gap-4 md:grid-cols-2 md:gap-6">
        <article class="rounded-3xl bg-gray-900 p-5 ring-1 ring-inset ring-green-500/40 md:p-6 light:bg-white light:ring-green-600/45">
          <p class="font-semibold text-green-400 light:text-green-700">✓ A Set: some features the same</p>
          <div class="mt-5 flex justify-center gap-3 md:gap-4">
            <div class="card-edge h-32 aspect-[5/7] md:h-40"><%= example_card(0, 1, 1, 2) %></div>
            <div class="card-edge h-32 aspect-[5/7] md:h-40"><%= example_card(1, 1, 1, 0) %></div>
            <div class="card-edge h-32 aspect-[5/7] md:h-40"><%= example_card(2, 1, 1, 1) %></div>
          </div>
          <ul class="mt-5 space-y-2 text-sm md:text-base">
            <li class="flex justify-between gap-4"><span class="text-gray-400 light:text-gray-600">Number</span><span class="text-gray-200 light:text-gray-800">all different <span class="text-green-400 light:text-green-700">✓</span></span></li>
            <li class="flex justify-between gap-4"><span class="text-gray-400 light:text-gray-600">Shape</span><span class="text-gray-200 light:text-gray-800">all the same <span class="text-green-400 light:text-green-700">✓</span></span></li>
            <li class="flex justify-between gap-4"><span class="text-gray-400 light:text-gray-600">Shading</span><span class="text-gray-200 light:text-gray-800">all the same <span class="text-green-400 light:text-green-700">✓</span></span></li>
            <li class="flex justify-between gap-4"><span class="text-gray-400 light:text-gray-600">Color</span><span class="text-gray-200 light:text-gray-800">all different <span class="text-green-400 light:text-green-700">✓</span></span></li>
          </ul>
        </article>
        <article class="rounded-3xl bg-gray-900 p-5 ring-1 ring-inset ring-green-500/40 md:p-6 light:bg-white light:ring-green-600/45">
          <p class="font-semibold text-green-400 light:text-green-700">✓ A Set: everything different</p>
          <div class="mt-5 flex justify-center gap-3 md:gap-4">
            <div class="card-edge h-32 aspect-[5/7] md:h-40"><%= example_card(0, 0, 0, 0) %></div>
            <div class="card-edge h-32 aspect-[5/7] md:h-40"><%= example_card(1, 1, 1, 1) %></div>
            <div class="card-edge h-32 aspect-[5/7] md:h-40"><%= example_card(2, 2, 2, 2) %></div>
          </div>
          <ul class="mt-5 space-y-2 text-sm md:text-base">
            <li class="flex justify-between gap-4"><span class="text-gray-400 light:text-gray-600">Number</span><span class="text-gray-200 light:text-gray-800">all different <span class="text-green-400 light:text-green-700">✓</span></span></li>
            <li class="flex justify-between gap-4"><span class="text-gray-400 light:text-gray-600">Shape</span><span class="text-gray-200 light:text-gray-800">all different <span class="text-green-400 light:text-green-700">✓</span></span></li>
            <li class="flex justify-between gap-4"><span class="text-gray-400 light:text-gray-600">Shading</span><span class="text-gray-200 light:text-gray-800">all different <span class="text-green-400 light:text-green-700">✓</span></span></li>
            <li class="flex justify-between gap-4"><span class="text-gray-400 light:text-gray-600">Color</span><span class="text-gray-200 light:text-gray-800">all different <span class="text-green-400 light:text-green-700">✓</span></span></li>
          </ul>
        </article>
      </div>
    </section>

    <section class="mt-16 md:mt-24">
      <h2 class="font-display text-3xl font-bold md:text-4xl">Almost, but not a Set</h2>
      <div class="mt-8 grid gap-6 rounded-3xl bg-gray-900 p-5 ring-1 ring-inset ring-red-500/40 md:grid-cols-[auto_minmax(0,1fr)] md:items-center md:gap-10 md:p-8 light:bg-white light:ring-red-600/45">
        <div class="flex justify-center gap-3 md:gap-4">
          <div class="card-edge h-32 aspect-[5/7] md:h-40"><%= example_card(0, 0, 0, 0) %></div>
          <div class="card-edge h-32 aspect-[5/7] md:h-40"><%= example_card(1, 2, 1, 0) %></div>
          <div class="card-edge h-32 aspect-[5/7] md:h-40"><%= example_card(2, 1, 2, 1) %></div>
        </div>
        <div>
          <p class="font-semibold text-red-400 light:text-red-700">✗ Not a Set</p>
          <ul class="mt-4 space-y-2 text-sm md:text-base">
            <li class="flex justify-between gap-4"><span class="text-gray-400 light:text-gray-600">Number</span><span class="text-gray-200 light:text-gray-800">all different <span class="text-green-400 light:text-green-700">✓</span></span></li>
            <li class="flex justify-between gap-4"><span class="text-gray-400 light:text-gray-600">Shape</span><span class="text-gray-200 light:text-gray-800">all different <span class="text-green-400 light:text-green-700">✓</span></span></li>
            <li class="flex justify-between gap-4"><span class="text-gray-400 light:text-gray-600">Shading</span><span class="text-gray-200 light:text-gray-800">all different <span class="text-green-400 light:text-green-700">✓</span></span></li>
            <li class="flex justify-between gap-4 rounded-lg bg-red-500/10 px-2 py-1 -mx-2 light:bg-red-50"><span class="text-red-300 light:text-red-700">Color</span><span class="text-red-200 light:text-red-800">two blue, one orange <span class="text-red-400 light:text-red-700">✗</span></span></li>
          </ul>
        </div>
      </div>
      <div class="mt-4 grid gap-4 md:grid-cols-2 md:gap-6">
        <div class="rounded-2xl bg-blue-500/10 px-5 py-4 ring-1 ring-inset ring-blue-500/40 light:bg-blue-50 light:ring-blue-600/35">
          <p class="font-semibold text-blue-300 light:text-blue-700">Quick check</p>
          <p class="mt-1 text-gray-200 light:text-gray-800">If two cards share something and the third doesn't, it's not a Set.</p>
        </div>
        <div class="rounded-2xl bg-blue-500/10 px-5 py-4 ring-1 ring-inset ring-blue-500/40 light:bg-blue-50 light:ring-blue-600/35">
          <p class="font-semibold text-blue-300 light:text-blue-700">Tip</p>
          <p class="mt-1 text-gray-200 light:text-gray-800">Pick any two cards. Only one card in the whole deck completes them, so look for that one.</p>
        </div>
      </div>
    </section>

    <section class="mt-16 md:mt-24">
      <h2 class="font-display text-3xl font-bold md:text-4xl">Playing Onset</h2>
      <ol class="mt-8 grid gap-4 md:grid-cols-2 md:gap-6">
        <li class="rounded-3xl bg-gray-900 p-5 md:p-6 light:bg-white light:shadow-[inset_0_0_0_1px_var(--color-gray-200)]">
          <span class="font-display text-4xl font-extrabold text-blue-400 light:text-blue-700">1</span>
          <h3 class="mt-2 text-xl font-bold">Join on your screen</h3>
          <p class="mt-2 text-gray-400 light:text-gray-600">Start a game, or join one with its room code, link or QR, then pick a name and a color.</p>
        </li>
        <li class="rounded-3xl bg-gray-900 p-5 md:p-6 light:bg-white light:shadow-[inset_0_0_0_1px_var(--color-gray-200)]">
          <span class="font-display text-4xl font-extrabold text-blue-400 light:text-blue-700">2</span>
          <h3 class="mt-2 text-xl font-bold">Look for a Set</h3>
          <p class="mt-2 text-gray-400 light:text-gray-600">Twelve cards go up on every player screen, and on the big screen if you use one. Everyone sees the same cards at the same time.</p>
        </li>
        <li class="rounded-3xl bg-gray-900 p-5 md:p-6 light:bg-white light:shadow-[inset_0_0_0_1px_var(--color-gray-200)]">
          <span class="font-display text-4xl font-extrabold text-blue-400 light:text-blue-700">3</span>
          <h3 class="mt-2 flex items-center gap-2 text-xl font-bold">Tap <span class="rounded-full bg-blue-600 px-3 py-0.5 text-white font-display text-base font-extrabold tracking-widest">SET!</span></h3>
          <p class="mt-2 text-gray-400 light:text-gray-600">Tap SET! on your screen, then pick the three cards within 15 seconds. Nobody else can call while you pick.</p>
        </li>
        <li class="rounded-3xl bg-gray-900 p-5 md:p-6 light:bg-white light:shadow-[inset_0_0_0_1px_var(--color-gray-200)]">
          <span class="font-display text-4xl font-extrabold text-blue-400 light:text-blue-700">4</span>
          <h3 class="mt-2 text-xl font-bold">Score</h3>
          <p class="mt-2 text-gray-400 light:text-gray-600"><span class="font-semibold text-green-400 light:text-green-700">Right: +1</span> and the three cards are replaced. <span class="font-semibold text-red-400 light:text-red-700">Wrong or out of time: −1, but never below 0</span> and you're locked out for <%= Game::CLAIM_TIMEOUT %> seconds.</p>
        </li>
      </ol>
      <div class="mt-4 grid gap-4 md:grid-cols-2 md:gap-6">
        <div class="rounded-3xl p-5 ring-1 ring-inset ring-purple-800 md:p-6 light:ring-purple-300">
          <h3 class="text-lg font-bold text-purple-300 light:text-purple-700">No Set on the table?</h3>
          <p class="mt-2 text-gray-400 light:text-gray-600">Anyone can call No Set. If the others agree within 15 seconds, three more cards go down.</p>
        </div>
        <div class="rounded-3xl p-5 ring-1 ring-inset ring-gray-800 md:p-6 light:ring-gray-200">
          <h3 class="text-lg font-bold">End of the game</h3>
          <p class="mt-2 text-gray-400 light:text-gray-600">The game ends when the deck runs out, or when someone reaches 5 points in a quick game. Most points wins.</p>
        </div>
      </div>
    </section>

    <section class="mt-16 rounded-3xl bg-gray-900 p-6 text-center md:mt-24 md:p-10 light:bg-white light:shadow-[inset_0_0_0_1px_var(--color-gray-200)]">
      <h2 class="font-display text-3xl font-bold md:text-4xl">Ready to play?</h2>
      <div class="mt-6 flex flex-col items-center justify-center gap-3 md:flex-row">
        <% if @player_screen_path %>
          <%= link_to "Back to the game", @player_screen_path, class: "inline-flex h-14 w-full items-center justify-center rounded-2xl bg-blue-600 px-8 text-lg font-bold text-white hover:bg-blue-500 active:scale-95 transition md:w-auto" %>
        <% else %>
          <%# Same form as the landing page's "Start a game" button, with these classes %>
          <%= button_to "Start a game", games_path, form: { class: "w-full md:w-auto" }, class: "inline-flex h-14 w-full items-center justify-center rounded-2xl bg-blue-600 px-8 text-lg font-bold text-white hover:bg-blue-500 active:scale-95 transition md:w-auto" %>
          <%= link_to "Join with a room code", root_path, class: "inline-flex h-14 w-full items-center justify-center rounded-2xl bg-gray-800 px-8 text-lg font-semibold hover:bg-gray-700 active:scale-95 transition md:w-auto light:bg-gray-200 light:hover:bg-gray-300" %>
        <% end %>
      </div>
    </section>
  </div>
  </div>
</main>
