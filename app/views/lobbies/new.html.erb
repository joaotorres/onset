<main class="min-h-dvh bg-gray-950 text-white flex items-center justify-center px-5 py-8 md:p-16">
  <div class="w-full max-w-sm grid gap-10 md:max-w-6xl md:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] md:items-center md:gap-24">
    <section class="flex flex-col items-center text-center md:items-start md:text-left">
      <h1 class="font-display text-7xl font-extrabold leading-none tracking-tight md:text-[10rem]">Onset</h1>
      <p class="mt-4 max-w-md text-base text-gray-400 md:text-2xl">Set, played live in the room. The cards go on the big screen, everyone buzzes in from their phone.</p>
      <figure class="mt-8 md:mt-14">
        <div class="flex items-end justify-center gap-3 md:justify-start md:gap-5">
          <% [[28, "-rotate-6 translate-y-2"], [40, ""], [52, "rotate-6 translate-y-2"]].each do |id, tilt| %>
            <div class="h-28 aspect-[5/7] md:h-64 <%= tilt %>"><%= render "cards/card", card: Card.new(id) %></div>
          <% end %>
        </div>
        <figcaption class="mt-5 text-sm text-gray-500 md:text-base">That's a Set: same number, same shading, every shape and color different.</figcaption>
      </figure>
      <%= link_to "New to Set? How to play →", how_to_play_path, class: "mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-blue-400 hover:text-blue-300 md:text-base" %>
    </section>

    <section class="flex flex-col gap-4">
      <div class="order-3 flex flex-col gap-3 md:order-1">
        <%= button_to games_path, method: :post,
              class: "w-full rounded-2xl bg-blue-600 hover:bg-blue-500 active:scale-95 transition px-6 py-4 text-left md:py-6" do %>
          <span class="block text-xl font-bold md:text-2xl">Start a game</span>
          <span class="block text-sm text-blue-100 md:text-base">This screen becomes the board</span>
        <% end %>
        <%= button_to games_path, method: :post, params: {mode: "quick"},
              class: "w-full rounded-2xl bg-violet-600 hover:bg-violet-500 active:scale-95 transition px-6 py-4 text-left md:py-6" do %>
          <span class="block text-xl font-bold md:text-2xl">Start quick game</span>
          <span class="block text-sm text-violet-100 md:text-base">First to <%= Game::QUICK_WIN_SCORE %> points wins</span>
        <% end %>
      </div>
      <div class="order-2 flex items-center gap-3 text-sm text-gray-500">
        <div class="h-px flex-1 bg-gray-800"></div>
        <span>or</span>
        <div class="h-px flex-1 bg-gray-800"></div>
      </div>
      <%= form_with url: join_by_code_path, method: :get, class: "order-1 md:order-3" do |f| %>
        <%= f.label :code, "Have a room code?", for: "room_code", class: "mb-2 block text-sm font-medium text-gray-400" %>
        <div class="flex gap-2">
          <%= f.text_field :code, id: "room_code", maxlength: 6, placeholder: "Room code", autocomplete: "off",
                autocapitalize: "characters", required: true,
                class: "h-14 min-w-0 flex-1 rounded-xl border border-gray-700 bg-gray-900 px-4 text-center font-display text-2xl font-bold uppercase tracking-[0.3em] placeholder:font-sans placeholder:text-base placeholder:font-normal placeholder:normal-case placeholder:tracking-normal placeholder:text-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
          <%= f.submit "Join", name: nil,
                class: "h-14 cursor-pointer rounded-xl bg-white px-6 font-bold text-gray-950 hover:bg-gray-200 active:scale-95 transition md:bg-gray-700 md:text-white md:hover:bg-gray-600" %>
        </div>
        <% if flash[:alert] %>
          <p class="mt-2 text-sm text-red-400"><%= flash[:alert] %></p>
        <% end %>
      <% end %>
    </section>
  </div>
</main>
