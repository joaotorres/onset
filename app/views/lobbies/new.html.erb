<% content_for :head, canonical_link(root_path) %>
<main class="grow bg-gray-950 text-white flex items-center justify-center px-5 py-7 lg:p-16">
  <div class="w-full max-w-sm flex flex-col gap-6 lg:max-w-6xl lg:grid lg:grid-cols-[minmax(0,1fr)_448px] lg:grid-rows-[auto_auto] lg:gap-x-20 lg:gap-y-10">
    <header class="order-1 lg:@container flex flex-col gap-2 lg:col-start-1 lg:row-start-1 lg:self-end lg:gap-7">
      <h1 class="font-display text-[3.25rem] font-extrabold leading-none tracking-tight lg:text-[min(8.5rem,36cqw)]">Onset</h1>
      <p class="max-w-lg text-base text-gray-300 lg:text-2xl">Set, played live in the room. Everyone plays on their own screen, and a big screen is optional.</p>
    </header>

    <section class="order-2 flex flex-col gap-6 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:self-center lg:rounded-3xl lg:border lg:border-gray-800 lg:bg-gray-900 lg:p-9 lg:gap-7">
      <%= form_with url: games_path, method: :post, class: "order-3 flex flex-col gap-3 lg:order-1" do %>
        <fieldset>
          <legend class="sr-only">Game mode</legend>
          <div class="grid grid-cols-2 gap-1 rounded-2xl border border-gray-700 bg-gray-900 p-1 lg:bg-gray-950">
            <label class="flex h-11 cursor-pointer items-center justify-center rounded-xl font-semibold text-gray-400 has-checked:bg-gray-700 has-checked:text-white has-focus-visible:ring-2 has-focus-visible:ring-blue-500">
              <%= radio_button_tag :mode, "standard", true, class: "sr-only" %>
              Standard
            </label>
            <label class="flex h-11 cursor-pointer items-center justify-center rounded-xl font-semibold text-gray-400 has-checked:bg-violet-600 has-checked:text-white has-focus-visible:ring-2 has-focus-visible:ring-blue-500">
              <%= radio_button_tag :mode, "quick", false, class: "sr-only" %>
              First to <%= Game::QUICK_WIN_SCORE %>
            </label>
          </div>
        </fieldset>
        <button type="submit" class="h-14 w-full cursor-pointer rounded-2xl bg-blue-600 font-display text-xl font-bold hover:bg-blue-500 active:scale-95 transition lg:h-15 lg:text-[1.375rem]">Start a game</button>
        <p class="text-center text-sm text-gray-400">Play from this screen, then invite the others</p>
      <% end %>

      <div class="order-2 h-px bg-gray-800"></div>

      <%= form_with url: join_by_code_path, method: :get, class: "order-1 flex flex-col gap-2 lg:order-3" do |f| %>
        <%= f.label :code, "Have a room code?", for: "room_code", class: "font-semibold" %>
        <div class="flex gap-2">
          <%= f.text_field :code, id: "room_code", maxlength: 6, placeholder: "Room code", autocomplete: "off",
                autocapitalize: "characters", required: true,
                aria: flash[:alert] ? {invalid: true, describedby: "room_code_error"} : {},
                class: "h-13 min-w-0 flex-1 rounded-xl border-2 bg-gray-900 px-4 font-display text-[1.375rem] font-bold uppercase tracking-[0.18em] placeholder:font-sans placeholder:text-base placeholder:font-normal placeholder:normal-case placeholder:tracking-normal placeholder:text-gray-500 focus:outline-none focus:ring-2 lg:bg-gray-950 #{flash[:alert] ? "border-red-500 focus:ring-red-500" : "border-gray-700 focus:ring-blue-500"}" %>
          <%= f.submit "Join", name: nil,
                class: "h-13 w-21 cursor-pointer rounded-xl border border-gray-700 bg-gray-800 font-semibold hover:bg-gray-700 active:scale-95 transition lg:w-24" %>
        </div>
        <% if flash[:alert] %>
          <p id="room_code_error" class="text-sm text-red-400"><%= flash[:alert] %></p>
        <% end %>
      <% end %>
    </section>

    <figure class="order-3 lg:@container flex items-center gap-4 lg:col-start-1 lg:row-start-2 lg:flex-col lg:items-start lg:gap-5">
      <div class="flex flex-none items-end gap-2 lg:gap-5">
        <% [[28, "-rotate-6 translate-y-1 lg:translate-y-2"], [40, ""], [52, "rotate-6 translate-y-1 lg:translate-y-2"]].each do |id, tilt| %>
          <div class="h-20 aspect-[5/7] lg:h-[min(12rem,calc((100cqw_-_2.5rem)*7/15))] <%= tilt %>"><%= render "cards/card", card: Card.new(id) %></div>
        <% end %>
      </div>
      <figcaption class="flex flex-col gap-1 text-sm text-gray-400 lg:text-base">
        <span>That's a Set: same number, same shading, every shape and color different.</span>
        <%= link_to "New to Set? How to play →", how_to_play_path, class: "inline-flex min-h-11 items-center font-semibold text-blue-400 hover:text-blue-300" %>
      </figcaption>
    </figure>
  </div>
</main>
