<% if game.waiting? %>
  <div id="board" class="flex-1 min-h-0 flex flex-col justify-center gap-12">
    <div class="flex items-center gap-14">
      <div class="shrink-0 rounded-3xl bg-white p-6"><%= join_qr_svg(game, "size-72") %></div>
      <div class="min-w-0">
        <p class="text-3xl text-gray-300">Scan to join, or open <span class="font-semibold text-white"><%= join_host %></span> and enter</p>
        <p class="mt-3 font-display text-[10rem] font-bold leading-none tracking-[0.12em]"><%= game.code %></p>
      </div>
    </div>

    <% if game.players.any? %>
      <ul class="flex flex-wrap gap-4">
        <% game.players.each do |p| %>
          <% ready = game.start_voters.include?(p.id) %>
          <li class="flex items-center gap-3 rounded-2xl bg-gray-900 px-6 py-4 text-3xl font-semibold <%= "text-gray-400" unless ready %>">
            <span class="size-5 rounded-full" style="background-color: <%= p.color %>;"></span>
            <%= p.name %>
            <% if ready %><span class="text-2xl text-green-400">✓</span><% end %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <%= render "games/start_button", game: game %>
  </div>

<% elsif game.ended? %>
  <div id="board" class="py-8">
    <h2 class="text-center text-3xl font-bold text-white mb-8">Game Over</h2>

    <%# Top-3 podium %>
    <% top_players = game.players.order(score: :desc).first(3) %>
    <% if top_players.any? %>
      <div class="flex items-end justify-center gap-4 mb-10">
        <% podium_order = top_players %>
        <% podium_order.each_with_index do |player, idx| %>
          <% rank = top_players.index(player) + 1 %>
          <% heights = {1 => "h-32", 2 => "h-20", 3 => "h-14"} %>
          <% text_sizes = {1 => "text-2xl", 2 => "text-xl", 3 => "text-lg"} %>
          <div class="flex flex-col items-center gap-2">
            <% if rank == 1 %>
              <span class="text-yellow-400 text-2xl">★</span>
            <% end %>
            <span class="<%= text_sizes[rank] %> font-bold text-white"><%= player.name %></span>
            <span class="text-gray-400 font-semibold"><%= player.score %> pts</span>
            <div class="<%= heights[rank] %> w-20 rounded-t-lg flex items-end justify-center pb-2"
                 style="background-color: <%= player.color %>; opacity: 0.85;">
              <span class="text-white font-bold text-lg">#<%= rank %></span>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# Full scoreboard %>
    <div class="max-w-xs mx-auto mb-8">
      <% game.players.order(score: :desc).each_with_index do |player, idx| %>
        <div class="flex items-center justify-between py-2 border-b border-gray-800">
          <div class="flex items-center gap-3">
            <span class="text-gray-500 w-5"><%= idx + 1 %></span>
            <span class="w-3 h-3 rounded-full flex-shrink-0" style="background-color: <%= player.color %>;"></span>
            <span class="text-white font-medium"><%= player.name %></span>
          </div>
          <span class="text-gray-300 font-semibold"><%= player.score %></span>
        </div>
      <% end %>
    </div>

    <%= button_to "Play Again", restart_game_path(game.code), method: :post,
          class: "block mx-auto px-10 py-3 bg-green-600 hover:bg-green-500 text-white text-lg font-semibold rounded-xl transition-colors" %>
  </div>
<% else %>
  <div id="board" class="flex-1 min-h-0 flex flex-col gap-4">
    <% if game.deck.empty? %>
      <p class="text-right"><span class="inline-block rounded-full bg-orange-500/15 px-5 py-1.5 text-xl font-semibold text-orange-400 ring-1 ring-inset ring-orange-500/40">Deck is empty · play out the remaining cards</span></p>
    <% else %>
      <p class="text-right text-xl text-gray-400"><span class="font-display text-3xl font-bold text-white tabular-nums"><%= game.deck.size %></span> cards left in the deck</p>
    <% end %>
    <div class="my-auto grid grid-rows-3 grid-flow-col auto-cols-max justify-center gap-6">
      <% game.board_cards.each do |card| %>
        <div class="h-60 aspect-[5/7]"><%= render "cards/card", card: card %></div>
      <% end %>
    </div>
  </div>
<% end %>
