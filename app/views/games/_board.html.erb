<% if game.waiting? %>
  <div id="board" class="flex-1 min-h-0 flex flex-col justify-center gap-12">
    <div class="flex items-center gap-14">
      <div class="shrink-0 rounded-3xl bg-white p-6"><%= join_qr_svg(game, "size-72") %></div>
      <div class="min-w-0">
        <p class="text-3xl text-gray-300">Scan to join, or open <span class="font-semibold text-white"><%= join_host %></span> and enter</p>
        <p class="mt-3 font-display text-[10rem] font-bold leading-none tracking-[0.12em]"><%= game.code %></p>
        <p class="mt-6 text-2xl text-gray-400">New to Set? The rules are at <span class="font-semibold text-white"><%= join_host %>/how-to-play</span></p>
      </div>
    </div>

    <% if game.players.any? %>
      <ul class="flex flex-wrap gap-4">
        <% game.players.each do |p| %>
          <% ready = game.start_voters.include?(p.id) %>
          <li class="flex items-center gap-3 rounded-2xl bg-gray-900 px-6 py-4 text-3xl font-semibold <%= "text-gray-400" unless ready %>">
            <span class="size-5 rounded-full" style="background-color: <%= p.color %>;"></span>
            <%= p.name %>
            <% if ready %><span class="text-2xl text-green-400">✓</span><% end %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <%= render "games/start_button", game: game %>
  </div>

<% elsif game.ended? %>
  <% standings = game.standings %>
  <% winner = game.winner %>
  <div id="board" class="flex-1 min-h-0 flex flex-col items-center justify-center">
    <p class="text-2xl uppercase tracking-[0.3em] text-gray-400">Game over</p>
    <h2 class="mt-3 font-display text-8xl font-extrabold"><%= winner ? "#{winner.name} wins" : "It's a tie" %></h2>

    <% if standings.any? %>
      <div class="mt-12 flex items-end gap-6">
        <%# Slot sets the bar height (2-1-3 order); the label is the real rank, so ties read #1 #1. %>
        <% [[standings[1], 2], [standings[0], 1], [standings[2], 3]].each do |player, slot| %>
          <% next unless player %>
          <div class="w-56 flex flex-col items-center">
            <% if player == winner %>
              <span class="text-6xl leading-none text-yellow-400">★</span>
            <% end %>
            <% if slot == 1 %>
              <p class="mt-2 text-4xl font-bold"><%= player.name %></p>
            <% else %>
              <p class="text-3xl font-semibold"><%= player.name %></p>
            <% end %>
            <p class="mb-3 text-2xl text-gray-400"><%= player.score %> pts</p>
            <div class="w-full <%= {1 => "h-56 text-5xl", 2 => "h-36 text-4xl", 3 => "h-24 text-4xl"}[slot] %> rounded-t-2xl flex justify-center pt-4 font-display font-bold"
                 style="background-color: <%= player.color %>D9;">#<%= game.rank_of(player) %></div>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= button_to "Play again", restart_game_path(game.code), method: :post,
          form_class: "mt-14",
          class: "h-20 rounded-2xl bg-green-600 hover:bg-green-500 active:scale-95 transition px-14 font-display text-3xl font-bold" %>
  </div>

<% else %>
  <div id="board" class="flex-1 min-h-0 flex flex-col gap-4">
    <% if game.deck.empty? %>
      <p class="text-right"><span class="inline-block rounded-full bg-orange-500/15 px-5 py-1.5 text-xl font-semibold text-orange-400 ring-1 ring-inset ring-orange-500/40">Deck is empty · play out the remaining cards</span></p>
    <% else %>
      <p class="text-right text-xl text-gray-400"><span class="font-display text-3xl font-bold text-white tabular-nums"><%= game.deck.size %></span> cards left in the deck</p>
    <% end %>
    <%# Cards are 15rem tall at 1080 px and shrink on shorter screens so row 3 never runs under the announcement. %>
    <div class="my-auto grid grid-rows-3 grid-flow-col auto-cols-max justify-center gap-6">
      <% game.board_cards.each do |card| %>
        <div class="h-[min(15rem,calc((100dvh-22rem)/3))] aspect-[5/7] <%= "rounded-xl outline-4 outline-offset-4 outline-green-400 animate-arrive" if game.just_dealt?(card.id) %>"><%= render "cards/card", card: card %></div>
      <% end %>
    </div>
  </div>
<% end %>
