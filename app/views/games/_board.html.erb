<% if game.waiting? %>
  <div id="board" data-version="<%= stream_version(game, *game.players) %>" class="flex-1 min-h-0 flex flex-col justify-center gap-12 snug:gap-8 tight:gap-6 compact:gap-5 cramped:gap-2">
    <%# Sizes step down with the window's height (SPEC §8 Big screen, Fit). %>
    <div class="flex items-center gap-14 compact:gap-10">
      <div class="shrink-0 flex flex-col items-center gap-4 compact:gap-2">
        <div class="rounded-3xl bg-white p-6 compact:p-4 light:shadow-[inset_0_0_0_1px_var(--color-gray-200)]" data-qr-tile><%= join_qr_svg(game, "size-72 snug:size-60 tight:size-52 compact:size-44 cramped:size-40") %></div>
        <%= link_to "Join from this computer →", join_game_players_path(game.code),
              target: "_blank", rel: "noopener",
              class: "whitespace-nowrap text-2xl leading-8 tight:text-xl tight:leading-7 compact:text-base compact:leading-6 cramped:text-sm font-semibold text-blue-400 hover:text-blue-300 light:text-blue-700 light:hover:text-blue-800", data: {join_here: true} %>
      </div>
      <%# The code shrinks with this column so it never runs into the rail at laptop widths. %>
      <div class="@container min-w-0 flex-1" data-hero-text>
        <p class="text-3xl compact:text-2xl text-gray-300 light:text-gray-700">Scan to join, or open <span class="font-semibold text-white light:text-gray-900"><%= join_host %></span> and enter</p>
        <p class="mt-3 whitespace-nowrap font-display text-[length:min(10rem,17cqi)] snug:text-[length:min(8rem,17cqi)] tight:text-[length:min(6rem,17cqi)] compact:text-[length:min(5rem,17cqi)] cramped:text-[length:min(4rem,17cqi)] font-bold leading-none tracking-[0.12em]" data-room-code><%= game.code %></p>
        <p class="mt-6 compact:mt-3 text-2xl compact:text-xl text-gray-400 wrap-anywhere light:text-gray-600">New to Set? The rules are at <span class="font-semibold text-white light:text-gray-900"><%= join_host %>/how-to-play</span></p>
      </div>
    </div>

    <% if game.players.any? %>
      <ul class="flex flex-wrap gap-4 compact:gap-3">
        <% game.players.each do |p| %>
          <% ready = game.start_voters.include?(p.id) %>
          <li class="flex items-center gap-3 rounded-2xl bg-gray-900 px-6 py-4 text-3xl snug:px-5 snug:py-3 snug:text-2xl compact:py-2 cramped:py-1.5 font-semibold light:bg-white light:shadow-[inset_0_0_0_1px_var(--color-gray-200)] <%= "text-gray-400 light:text-gray-600" unless ready %>">
            <span class="size-5 snug:size-4 rounded-full" style="background-color: <%= p.color %>;"></span>
            <%= p.name %>
            <% if ready %><span class="text-2xl snug:text-xl text-green-400 light:text-green-700">✓</span><% end %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <%= render "games/start_button", game: game %>
  </div>

<% elsif game.ended? %>
  <% standings = game.standings %>
  <% winner = game.winner %>
  <div id="board" data-version="<%= stream_version(game) %>" class="flex-1 min-h-0 flex flex-col items-center justify-center">
    <p class="text-2xl compact:text-xl uppercase tracking-[0.3em] text-gray-400 light:text-gray-600">Game over</p>
    <h2 class="mt-3 font-display text-8xl snug:text-7xl tight:text-6xl compact:text-5xl font-extrabold leading-none"><%= winner ? "#{winner.name} wins" : "It's a tie" %></h2>

    <% if standings.any? %>
      <div class="mt-12 snug:mt-8 compact:mt-4 flex items-end gap-6">
        <%# Slot sets the bar height (2-1-3 order); the label is the real rank, so ties read #1 #1. %>
        <% [[standings[1], 2], [standings[0], 1], [standings[2], 3]].each do |player, slot| %>
          <% next unless player %>
          <div class="w-56 flex flex-col items-center">
            <% if player == winner %>
              <span class="text-6xl snug:text-5xl compact:text-3xl leading-none text-yellow-400 light:text-yellow-700">★</span>
            <% end %>
            <% if slot == 1 %>
              <p class="mt-2 text-4xl compact:text-3xl font-bold"><%= player.name %></p>
            <% else %>
              <p class="text-3xl compact:text-2xl font-semibold"><%= player.name %></p>
            <% end %>
            <p class="mb-3 compact:mb-2 text-2xl compact:text-xl text-gray-400 light:text-gray-600"><%= player.score %> pts</p>
            <%# The rank stays white on the player's color in both themes, as meaning fills keep white text (DESIGN v6). %>
            <div class="w-full <%= {1 => "h-56 snug:h-44 tight:h-36 compact:h-28 cramped:h-24 text-5xl compact:text-3xl", 2 => "h-36 snug:h-28 tight:h-24 compact:h-20 cramped:h-16 text-4xl compact:text-2xl", 3 => "h-24 snug:h-20 tight:h-16 compact:h-14 cramped:h-12 text-4xl compact:text-2xl"}[slot] %> rounded-t-2xl flex justify-center pt-4 compact:pt-2 font-display font-bold text-white"
                 style="background-color: <%= player.color %>D9;">#<%= game.rank_of(player) %></div>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= button_to "Play again", restart_game_path(game.code), method: :post,
          form_class: "mt-14 snug:mt-10 compact:mt-5",
          class: "h-20 compact:h-14 rounded-2xl bg-green-700 text-white hover:bg-green-800 active:scale-95 transition px-14 font-display text-3xl font-bold" %>
  </div>

<% else %>
  <div id="board" data-version="<%= stream_version(game) %>" class="flex-1 min-h-0 flex flex-col gap-4">
    <% if game.deck.empty? %>
      <p class="text-right"><span class="inline-block rounded-full bg-orange-500/15 px-5 py-1.5 text-xl font-semibold text-orange-400 ring-1 ring-inset ring-orange-500/40 light:bg-orange-50 light:text-orange-800 light:ring-orange-600/45">Deck is empty · play out the remaining cards</span></p>
    <% else %>
      <p class="text-right text-xl text-gray-400 light:text-gray-600"><span class="font-display text-3xl font-bold text-white tabular-nums light:text-gray-900"><%= game.deck.size %></span> cards left in the deck</p>
    <% end %>
    <%# Cards are 15rem tall at 1080 px and shrink on shorter screens so row 3 never runs under the announcement.
        The light card edge (DESIGN v6) sits on a span inside the wrapper, so it never meets the arrive outline. %>
    <div class="my-auto grid grid-rows-3 grid-flow-col auto-cols-max justify-center gap-6">
      <% game.board_cards.each do |card| %>
        <div class="h-[min(15rem,calc((100dvh-22rem)/3))] aspect-[5/7] <%= "rounded-xl outline-4 outline-offset-4 outline-green-400 animate-arrive light:outline-green-600 light:[--arrive-outline:var(--color-green-600)]" if game.just_dealt?(card.id) %>"><span class="card-edge block size-full"><%= render "cards/card", card: card %></span></div>
      <% end %>
    </div>
  </div>
<% end %>
