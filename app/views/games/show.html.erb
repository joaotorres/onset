<% join_url = join_game_players_url(@game.code) %>
<% qr_svg = RQRCode::QRCode.new(join_url).as_svg(
     offset: 0, color: "030712", shape_rendering: "crispEdges",
     module_size: 4, standalone: true, use_path: true,
     viewbox: true, svg_attributes: {class: "w-full h-full"}
   ) %>

<div class="min-h-screen bg-gray-950 text-white p-6">
  <div class="max-w-5xl mx-auto">
    <%= turbo_stream_from "game:#{@game.code}" %>

    <div class="flex justify-between items-start mb-8">
      <div class="flex items-start gap-6">
        <div>
          <p class="text-gray-400 text-sm uppercase tracking-widest mb-1">Room</p>
          <p class="text-5xl font-bold tracking-widest"><%= @game.code %></p>
          <p class="text-gray-500 text-xs mt-2 max-w-32 break-all"><%= join_url %></p>
        </div>
        <div class="w-28 h-28 bg-white rounded-xl p-2 flex-shrink-0">
          <%= qr_svg.html_safe %>
        </div>
      </div>

      <%= render "scoreboard", game: @game %>
    </div>

    <%= render "board", game: @game %>

    <div class="mt-6">
      <%= render "start_button", game: @game %>

      <%= render "announcement", game: @game, flash_claim: @game.flash_claim %>
    </div>

  </div>
</div>
