<% join_url = join_game_players_url(@game.code) %>
<% qr_svg = RQRCode::QRCode.new(join_url).as_svg(
     offset: 0, color: "fff", shape_rendering: "crispEdges",
     module_size: 4, standalone: true, use_path: true,
     viewbox: true, svg_attributes: {class: "w-full h-full"}
   ) %>

<div class="min-h-screen bg-gray-950 text-white p-6">
  <div class="max-w-5xl mx-auto">

    <div class="flex justify-between items-start mb-8">
      <div class="flex items-start gap-6">
        <div>
          <p class="text-gray-400 text-sm uppercase tracking-widest mb-1">Room</p>
          <p class="text-5xl font-bold tracking-widest"><%= @game.code %></p>
          <p class="text-gray-500 text-xs mt-2 max-w-32 break-all"><%= join_url %></p>
        </div>
        <div class="w-28 h-28 bg-gray-800 rounded-xl p-1 flex-shrink-0">
          <%= qr_svg.html_safe %>
        </div>
      </div>

      <div class="text-right min-w-40">
        <p class="text-gray-400 text-sm uppercase tracking-widest mb-3">Players</p>
        <% if @game.players.any? %>
          <ul class="space-y-2">
            <% @game.players.each do |player| %>
              <li class="flex items-center justify-end gap-2">
                <span class="text-white font-medium"><%= player.name %></span>
                <span class="w-3 h-3 rounded-full flex-shrink-0" style="background-color: <%= player.color %>;"></span>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-gray-500 italic text-sm">Waiting for players…</p>
        <% end %>
      </div>
    </div>

    <div class="grid grid-cols-4 gap-3">
      <% @placeholder_cards.each do |card| %>
        <div class="aspect-[5/7]">
          <%= render "cards/card", card: card %>
        </div>
      <% end %>
    </div>

    <div class="mt-6 text-center text-gray-600 text-sm">
      Scan the QR code to join on your phone
    </div>

  </div>
</div>
