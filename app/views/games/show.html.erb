<%= turbo_stream_from "game:#{@game.code}" %>

<main class="h-dvh overflow-hidden bg-gray-950 text-white p-10 grid grid-cols-[minmax(0,1fr)_26rem] gap-10">
  <div class="min-h-0 flex flex-col gap-6">
    <%= render "board", game: @game %>
    <%= render "announcement", game: @game, flash_claim: @game.flash_claim %>
  </div>

  <aside class="min-h-0 flex flex-col gap-8">
    <%= render "room_tile", game: @game %>
    <div class="min-h-0">
      <p class="mb-3 px-5 text-lg uppercase tracking-widest text-gray-400">Players</p>
      <%= render "scoreboard", game: @game %>
    </div>
  </aside>
</main>
