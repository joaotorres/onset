<%# Hidden while waiting: the join hero carries the code and the only QR (§8, Big screen). %>
<div id="room_tile" data-version="<%= stream_version(game) %>">
  <% unless game.waiting? %>
    <div class="rounded-3xl bg-gray-900 p-5 light:bg-white light:shadow-[inset_0_0_0_1px_var(--color-gray-200)]">
      <p class="text-lg uppercase tracking-widest text-gray-400 light:text-gray-600">Room</p>
      <p class="font-display text-5xl font-bold leading-none tracking-wider"><%= game.code %></p>
      <p class="mt-2 truncate text-lg text-gray-400 light:text-gray-600"><%= join_host %></p>
    </div>
  <% end %>
</div>
