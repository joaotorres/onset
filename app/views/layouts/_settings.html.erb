<%# SPEC.md §8, Settings menu. Never inside a broadcast target (§7, Hooks), so a room update never closes or resets it. %>
<%# variant: (DESIGN v6, Settings button) the default 44x44 bordered button on the landing, join page and How to play,
    the menu opening below it. :player_screen gives the player screen's footer button, 40x28 with no border and the
    icon in muted text, 40x32 in the computer Waiting and Game over footers, the menu opening above it.
    :big_screen gives the big screen's corner button, 56x56, radius 16, 26px icon, the menu opening above it;
    its menu sits 108px from the bottom (Settings button placement): 12px above its 96px-high corner button. %>
<% theme = chosen_theme || "device" %>
<% bordered = "border border-gray-800 text-gray-400 aria-expanded:bg-gray-800 light:border-gray-200 light:text-gray-600 light:aria-expanded:bg-gray-100" %>
<% look = {
     default: {button: "size-11 rounded-xl #{bordered}", icon: "size-5", menu: "top-full mt-2"},
     player_screen: {button: "h-7 w-10 rounded-lg text-muted light:text-gray-500 lg:h-8 lg:group-has-[[data-board]]/main:h-7 aria-expanded:bg-gray-800 light:aria-expanded:bg-gray-200",
                     icon: "size-4 lg:size-[18px]", menu: "bottom-full mb-2"},
     big_screen: {button: "size-14 rounded-2xl #{bordered}", icon: "size-[26px]", menu: "bottom-full mb-3"}
   }.fetch(local_assigns.fetch(:variant, :default)) %>
<% button_look, icon_size, menu_place = look.values_at(:button, :icon, :menu) %>
<div data-controller="settings" data-settings-theme-colors-value="<%= theme_color_values %>" data-action="keydown.esc@document->settings#escape turbo:before-cache@document->settings#dismiss turbo:before-render@document->settings#syncFromCookies" class="<%= local_assigns[:class] || "relative" %>">
  <button type="button" aria-label="Settings" aria-expanded="false" aria-controls="settings_menu" aria-haspopup="dialog"
          data-settings-target="button" data-action="settings#toggle"
          class="grid cursor-pointer place-items-center transition hover:text-gray-50 aria-expanded:text-gray-50 light:hover:text-gray-900 light:aria-expanded:text-gray-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500 <%= button_look %>">
    <svg class="<%= icon_size %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
  </button>

  <%# A tap outside lands here: it closes the menu and reaches nothing under it. Transparent, so no dimming. %>
  <div hidden data-settings-target="shield" data-action="click->settings#dismiss" class="fixed inset-0 z-40"></div>

  <div id="settings_menu" role="dialog" aria-label="Settings" hidden data-settings-target="menu"
       class="absolute right-0 z-50 <%= menu_place %> flex w-[304px] max-w-[calc(100vw-2rem)] flex-col gap-3.5 rounded-2xl border border-gray-700 bg-gray-900 p-4 text-left text-gray-50 shadow-[0_12px_32px_rgba(0,0,0,0.6)] light:border-gray-300 light:bg-white light:text-gray-900 light:shadow-[0_12px_32px_rgba(3,7,18,0.18)]">
    <div class="flex items-center justify-between">
      <p class="text-[17px] font-bold">Settings</p>
      <button type="button" aria-label="Close settings" data-action="settings#closeButton"
              class="-mr-1.5 grid size-9 cursor-pointer place-items-center rounded-lg text-gray-400 hover:text-gray-50 light:text-gray-600 light:hover:text-gray-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>

    <fieldset>
      <legend class="mb-2 text-xs font-semibold uppercase tracking-[0.08em] text-gray-400 light:text-gray-600">Theme</legend>
      <div class="grid grid-cols-3 gap-1 rounded-[14px] border border-gray-700 bg-gray-950 p-1 light:border-gray-300 light:bg-gray-100">
        <% [["device", "Match device", '<circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/>'],
            ["light", "Light", '<circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>'],
            ["dark", "Dark", '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>']].each do |value, label, icon| %>
          <label class="flex h-14 cursor-pointer flex-col items-center justify-center gap-1 rounded-[10px] text-xs font-semibold text-gray-400 has-checked:bg-gray-700 has-checked:text-white has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-blue-500 light:text-gray-600 light:has-checked:bg-gray-800 light:has-checked:text-white">
            <input type="radio" name="theme" value="<%= value %>" <%= "checked" if value == theme %> class="sr-only" data-action="settings#pick">
            <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%= icon.html_safe %></svg>
            <%= label %>
          </label>
        <% end %>
      </div>
    </fieldset>

    <%# §10 Palette. The chips show each option's own colors whatever is picked, so they read the per-palette
        custom properties (application.css), never the switching --card-color-*. %>
    <fieldset>
      <legend class="mb-2 text-xs font-semibold uppercase tracking-[0.08em] text-gray-400 light:text-gray-600">Card colors</legend>
      <div class="grid grid-cols-2 gap-1 rounded-[14px] border border-gray-700 bg-gray-950 p-1 light:border-gray-300 light:bg-gray-100">
        <% [["classic", "Classic"], ["colorblind", "Color-blind"]].each do |value, label| %>
          <label class="flex h-14 cursor-pointer flex-col items-center justify-center gap-1.5 rounded-[10px] text-[13px] font-semibold text-gray-400 has-checked:bg-gray-700 has-checked:text-white has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-blue-500 light:text-gray-600 light:has-checked:bg-gray-800 light:has-checked:text-white">
            <input type="radio" name="card_colors" value="<%= value %>" <%= "checked" if value == (chosen_card_colors || "classic") %> class="sr-only" data-action="settings#pickCardColors">
            <span class="flex h-4 w-[54px] items-center justify-center gap-2 rounded bg-(--card-face)" aria-hidden="true">
              <% if value == "classic" %>
                <% 3.times do |color| %>
                  <span class="size-[9px] rounded-full" style="background-color: var(--card-classic-<%= color %>);"></span>
                <% end %>
              <% else %>
                <% CardsHelper::COLOR_MARKS.each_with_index do |points, color| %>
                  <svg class="size-2.5" viewBox="-15 -15 30 30"><polygon style="fill: var(--card-colorblind-<%= color %>);" points="<%= points %>"/></svg>
                <% end %>
              <% end %>
            </span>
            <%= label %>
          </label>
        <% end %>
      </div>
    </fieldset>
  </div>
</div>
