<%# Countdown ring with the seconds inside. Caller wraps it in data-controller="countdown". %>
<div class="relative shrink-0 <%= size %>">
  <svg viewBox="0 0 100 100" class="size-full -rotate-90" aria-hidden="true">
    <circle cx="50" cy="50" r="45" fill="none" stroke-width="8" class="<%= track %>"></circle>
    <circle data-countdown-target="ring" cx="50" cy="50" r="45" fill="none" stroke-width="8" stroke-linecap="round" stroke-dasharray="282.74" class="<%= stroke %>"></circle>
  </svg>
  <span data-countdown-target="display" class="absolute inset-0 grid place-items-center font-display font-extrabold tabular-nums <%= digits %>"><%= duration %></span>
</div>
