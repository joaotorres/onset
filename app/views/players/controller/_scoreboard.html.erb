<%# The play scoreboard: every player by score, ties in join order.
    Portrait: chips across the top, 4 per row, the Locked tag a badge on the corner.
    Landscape: the 132px scores column on the right, one row per player, the Locked tag inline before the score. %>
<ol data-scoreboard aria-label="Scoreboard" class="<%= local_assigns[:class] %> flex shrink-0 flex-wrap content-start gap-1.5 pt-2 landscape:order-last landscape:w-[132px] landscape:flex-col landscape:flex-nowrap landscape:gap-[3px] landscape:pt-0">
  <% game.standings.each do |p| %>
    <% claiming = game.claim_player_id == p.id %>
    <% locked = !claiming && p.locked? %>
    <% look = if claiming then "border-yellow-400 bg-yellow-400 text-gray-950"
              elsif p.id == player.id then "border-gray-500 bg-gray-800"
              else "border-gray-800 bg-gray-900"
              end %>
    <% fade = "opacity-45" if locked %>
    <li class="relative flex h-[30px] w-[calc((100%-18px)/4)] min-w-0 shrink-0 items-center gap-[5px] rounded-lg border px-[7px] landscape:h-7 landscape:w-full landscape:gap-1.5 landscape:px-2 <%= look %>">
      <span data-entry-content class="flex min-w-0 flex-1 items-center gap-[5px] landscape:gap-1.5 <%= fade %>">
        <span class="size-2 shrink-0 rounded-full" style="background-color: <%= p.color %>;"></span>
        <span data-name class="min-w-0 flex-1 truncate text-xs font-medium landscape:text-[13px]"><%= p.name %></span>
      </span>
      <% if locked %>
        <span data-locked-tag class="shrink-0 rounded-md bg-red-600 px-[5px] py-px text-[9px] font-bold uppercase leading-tight tracking-wide text-white portrait:absolute portrait:-top-2 portrait:right-1 landscape:static landscape:rounded-[5px] landscape:px-1">Locked</span>
      <% end %>
      <span data-score class="shrink-0 font-display text-[15px] font-bold tabular-nums <%= fade %>"><%= p.score %></span>
    </li>
  <% end %>
</ol>
