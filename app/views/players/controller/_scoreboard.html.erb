<%# The play scoreboard: every player by score, ties in join order.
    Portrait: chips across the top, 4 per row, the Locked tag a badge on the corner.
    Landscape: the 132px scores column on the right, one row per player, the Locked tag inline before the score.
    Computer: the same rows in a gray-900 panel at the top of the 248px side column. %>
<ol data-scoreboard aria-label="Scoreboard" class="<%= local_assigns[:class] %> flex shrink-0 flex-wrap content-start gap-1.5 pt-2 landscape:max-lg:order-last landscape:max-lg:w-[132px] landscape:max-lg:flex-col landscape:max-lg:flex-nowrap landscape:max-lg:gap-[3px] landscape:max-lg:pt-0 lg:col-start-2 lg:row-start-1 lg:flex-col lg:flex-nowrap lg:gap-1 lg:rounded-2xl lg:border lg:border-gray-800 lg:bg-gray-900 lg:p-2.5">
  <% game.standings.each do |p| %>
    <% claiming = game.claim_player_id == p.id %>
    <% locked = !claiming && p.locked? %>
    <% look = if claiming then "border-yellow-400 bg-yellow-400 text-gray-950"
              elsif p.id == player.id then "border-gray-500 bg-gray-800"
              else "border-gray-800 bg-gray-900"
              end %>
    <% fade = "opacity-45" if locked %>
    <li class="relative flex h-[30px] w-[calc((100%-18px)/4)] min-w-0 shrink-0 items-center gap-[5px] rounded-lg border px-[7px] landscape:max-lg:h-7 landscape:max-lg:w-full landscape:max-lg:gap-1.5 landscape:max-lg:px-2 lg:h-7 lg:w-full lg:gap-2 lg:px-2.5 <%= look %>">
      <span data-entry-content class="flex min-w-0 flex-1 items-center gap-[5px] landscape:max-lg:gap-1.5 lg:gap-2 <%= fade %>">
        <span class="size-2 shrink-0 rounded-full lg:size-2.5" style="background-color: <%= p.color %>;"></span>
        <span data-name class="min-w-0 flex-1 truncate text-xs font-medium landscape:max-lg:text-[13px] lg:text-sm"><%= p.name %></span>
      </span>
      <% if locked %>
        <span data-locked-tag class="shrink-0 rounded-md bg-red-600 px-[5px] py-px text-[9px] font-bold uppercase leading-tight tracking-wide text-white portrait:max-lg:absolute portrait:max-lg:-top-2 portrait:max-lg:right-1 landscape:max-lg:static landscape:max-lg:rounded-[5px] landscape:max-lg:px-1 lg:rounded-[5px] lg:px-1.5 lg:text-[10px]">Locked</span>
      <% end %>
      <span data-score class="shrink-0 font-display text-[15px] font-bold tabular-nums lg:text-[17px] <%= fade %>"><%= p.score %></span>
    </li>
  <% end %>
</ol>
