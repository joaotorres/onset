<%# The fixed status slot above SET!: 64px tall in portrait, 144x104 in the landscape action column, in every state, empty while idle. %>
<% panel = "flex h-full rounded-[14px]" %>
<div data-status-slot class="<%= local_assigns[:class] %> h-16 shrink-0 landscape:h-[104px] landscape:w-full">
  <% case local_assigns[:variant] %>
  <% when :claim %>
    <div role="status" class="<%= panel %> items-center gap-3 bg-yellow-400 px-3.5 text-gray-950"
         data-controller="countdown"
         data-countdown-started-at-value="<%= game.claim_started_at.iso8601 %>"
         data-countdown-duration-value="<%= Game::CLAIM_TIMEOUT %>">
      <%= render "players/controller/small_ring", size: "size-11", track: "stroke-gray-950/20", stroke: "stroke-gray-950", digits: "text-[17px]", duration: Game::CLAIM_TIMEOUT %>
      <div class="min-w-0 flex-1">
        <p class="font-display text-[21px] font-extrabold leading-tight">Your SET!</p>
        <p class="text-[13px] font-semibold">Tap 3 cards</p>
      </div>
      <p class="font-display text-[26px] font-extrabold tabular-nums"><span data-card-selection-target="count">0</span>/3</p>
    </div>
  <% when :other %>
    <div role="status" class="<%= panel %> items-center justify-center gap-2.5 border-2 border-yellow-400 bg-gray-900 px-4 landscape:flex-col landscape:gap-1 landscape:px-2 landscape:text-center">
      <p class="flex min-w-0 items-center gap-2.5 landscape:gap-[7px]">
        <span class="size-3 shrink-0 rounded-full landscape:size-2.5" style="background-color: <%= game.claiming_player.color %>;"></span>
        <span class="min-w-0 truncate text-lg font-bold landscape:text-[17px]"><%= game.claiming_player.name %></span>
      </p>
      <p class="shrink-0 text-gray-300 landscape:text-[13px]">is calling SET!</p>
    </div>
  <% when :no_set %>
    <%# Portrait: the ring left of the caller and the count. Landscape: the ring and the count on top, the caller under them. %>
    <div role="status" class="<%= panel %> grid grid-cols-[auto_minmax(0,1fr)] content-center items-center gap-x-3 border-2 border-purple-500 bg-purple-950 px-3.5 landscape:gap-x-2 landscape:gap-y-1.5 landscape:px-2.5"
         data-controller="countdown"
         data-countdown-started-at-value="<%= game.no_set_started_at.iso8601 %>"
         data-countdown-duration-value="15">
      <div class="row-span-2 landscape:row-span-1">
        <%= render "players/controller/small_ring", size: "size-11 landscape:size-9", track: "stroke-white/15", stroke: "stroke-purple-400", digits: "text-[17px] landscape:text-sm", duration: 15 %>
      </div>
      <p class="col-start-2 row-start-1 truncate font-bold landscape:col-span-2 landscape:col-start-1 landscape:row-start-2 landscape:whitespace-normal landscape:text-[13px] landscape:leading-tight">No Set called by <%= game.no_set_caller.name %></p>
      <p class="col-start-2 row-start-2 text-[13px] text-purple-200 landscape:row-start-1"><%= game.no_set_voters.size %>/<%= game.players.select(&:active?).size %> agreed</p>
    </div>
  <% when :locked %>
    <p role="status" class="<%= panel %> animate-shake items-center justify-center border-2 border-red-600 bg-red-950 px-2 text-center font-display text-[28px] font-extrabold leading-tight text-red-200 landscape:text-[21px]"><%= (player.lockout_reason == "expired") ? "Time's up! −1" : "Wrong! −1" %></p>
  <% end %>
</div>
