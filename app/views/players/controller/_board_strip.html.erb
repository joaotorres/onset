<%# Landscape-only board on the left. Idle passes tappable: a card tap calls SET! (§8). %>
<% grid = "h-full grid grid-rows-3 grid-flow-col auto-cols-max gap-2" %>
<div class="portrait:hidden flex-1 min-w-0 overflow-x-auto">
  <% if local_assigns[:tappable] %>
    <%= form_with url: game_claims_path(game.code), method: :post, class: grid, data: {controller: "card-tap"} do %>
      <% game.board_cards.each do |card| %>
        <button type="submit" class="h-full aspect-[5/7] cursor-pointer"
                data-card-id="<%= card.id %>"
                data-action="click->card-tap#tap">
          <%= render "cards/card", card: card %>
        </button>
      <% end %>
    <% end %>
  <% else %>
    <div class="<%= grid %>">
      <% game.board_cards.each do |card| %>
        <div class="h-full aspect-[5/7]"><%= render "cards/card", card: card %></div>
      <% end %>
    </div>
  <% end %>
</div>
