<%
  game = local_assigns[:game] || player.game
  flash_claim = local_assigns[:flash_claim]
  my_claim = (game.claim_player_id == player.id) ? game.claims.find_by(player: player, result: :pending) : nil
  locked = player.locked?
  set_round = "portrait:size-64 portrait:rounded-full landscape:size-full landscape:rounded-3xl"
%>
<div id="controller_status" class="flex-1 min-h-0 flex flex-col">
  <% if flash_claim&.correct? && flash_claim.card_ids.present? %>
    <div class="found-set-flash pointer-events-none fixed inset-x-0 top-0 z-10 flex items-center gap-4 border-b-2 border-green-500 bg-gray-900/95 px-4 py-3">
      <div class="flex shrink-0 gap-2">
        <% flash_claim.card_ids.map { |cid| Card.new(cid) }.each do |card| %>
          <div class="h-20 aspect-[5/7]"><%= render "cards/card", card: card %></div>
        <% end %>
      </div>
      <div class="min-w-0">
        <p class="flex items-center gap-2 truncate text-xl font-bold"><span class="size-3 shrink-0 rounded-full" style="background-color: <%= flash_claim.player.color %>;"></span><%= flash_claim.player.name %></p>
        <p class="text-sm text-gray-400">found a Set</p>
      </div>
      <p class="ml-auto font-display text-4xl font-extrabold text-green-400">+1</p>
    </div>
  <% end %>

  <%= render "players/controller/header", player: player, score_class: (game.playing? && locked && !my_claim && !game.claim_active? && !game.no_set_active?) ? "text-red-400" : nil %>

  <% if game.waiting? %>
    <% total = game.players.count %>
    <% voted = game.start_voters.size %>
    <% status_box = "grid h-16 w-full place-items-center rounded-2xl border-2 px-3 text-center font-semibold landscape:h-full" %>
    <div class="flex-1 min-h-0 flex portrait:flex-col landscape:gap-4">
      <div class="flex-1 min-h-0 flex flex-col justify-center landscape:min-w-0">
        <h2 class="font-display text-4xl font-bold landscape:text-2xl">You're in</h2>
        <p class="mt-1 text-gray-400">Waiting for players…</p>
        <ul class="mt-6 grid grid-cols-2 gap-2 landscape:mt-4">
          <% game.players.each do |p| %>
            <% ready = game.start_voters.include?(p.id) %>
            <li class="flex items-center gap-2 rounded-xl bg-gray-900 px-3 py-3">
              <span class="size-3 shrink-0 rounded-full" style="background-color: <%= p.color %>;"></span>
              <span class="truncate font-medium"><%= p.name %></span>
              <% if p.id == player.id %><span class="ml-auto text-sm text-gray-500">you</span><% end %>
              <% if ready %><span class="<%= "ml-auto" unless p.id == player.id %> text-green-400">✓</span><% end %>
            </li>
          <% end %>
        </ul>
      </div>
      <div class="flex portrait:mt-6 landscape:w-36 landscape:shrink-0">
        <% if total < 2 %>
          <p class="<%= status_box %> border-gray-700 text-gray-400">Waiting for more players to join…</p>
        <% elsif game.start_voters.include?(player.id) %>
          <p class="<%= status_box %> border-green-600 text-green-400">Ready ✓ · waiting for <%= total - voted %> more</p>
        <% else %>
          <%= button_to "I'm ready", ready_game_path(game.code), method: :post,
                form_class: "contents", data: {turbo_submits_with: "…"},
                class: "h-16 w-full rounded-2xl bg-green-600 hover:bg-green-500 active:scale-95 transition font-display text-2xl font-bold shadow-xl landscape:h-full" %>
        <% end %>
      </div>
      <%= render "players/controller/info_column", player: player %>
    </div>

  <% elsif game.ended? %>
    <% rank = game.rank_of(player) %>
    <% winner = game.winner %>
    <div class="flex-1 flex flex-col items-center justify-center text-center">
      <p class="text-sm uppercase tracking-[0.3em] text-gray-400">Game over</p>
      <p class="mt-6 font-display text-8xl font-extrabold leading-none landscape:mt-3 landscape:text-6xl"><%= rank.ordinalize %></p>
      <p class="mt-2 text-xl text-gray-300">of <%= game.players.size %> players · <%= pluralize(player.score, "point") %></p>
      <% if winner %>
        <p class="mt-10 flex items-center gap-2 text-lg landscape:mt-5"><span class="text-yellow-400">★</span><span class="size-3 rounded-full" style="background-color: <%= winner.color %>;"></span><%= winner == player ? "You win" : "#{winner.name} wins" %> with <%= winner.score %></p>
      <% else %>
        <p class="mt-10 text-lg landscape:mt-5"><span class="text-yellow-400">★</span> Tied for first at <%= game.standings.first&.score %></p>
      <% end %>
      <p class="mt-8 text-sm text-gray-500 landscape:mt-4">Play again from the big screen</p>
    </div>

  <% elsif my_claim %>
    <%# Claiming (mine): pick 3 cards. %>
    <div data-controller="card-selection" class="flex-1 min-h-0 flex portrait:flex-col portrait:gap-4 landscape:gap-3">
      <div class="landscape:hidden flex items-center gap-4 rounded-2xl bg-yellow-400 px-4 py-3 text-gray-950"
           data-controller="countdown"
           data-countdown-started-at-value="<%= game.claim_started_at.iso8601 %>"
           data-countdown-duration-value="<%= Game::CLAIM_TIMEOUT %>">
        <%= render "players/controller/small_ring", size: "size-14", track: "stroke-yellow-600", stroke: "stroke-gray-950", digits: "text-2xl", duration: Game::CLAIM_TIMEOUT %>
        <div class="min-w-0 flex-1">
          <p class="font-display text-2xl font-bold leading-tight">Your SET!</p>
          <p class="text-sm font-medium">Tap 3 cards</p>
        </div>
        <p class="font-display text-3xl font-bold tabular-nums"><span data-card-selection-target="count">0</span><span class="opacity-50">/3</span></p>
      </div>

      <div class="landscape:hidden grid grid-cols-3 gap-3 px-4">
        <% 3.times do |i| %>
          <div data-card-selection-target="slot" class="aspect-[5/7] grid place-items-center rounded-xl border-2 border-dashed border-gray-700 font-display text-3xl font-bold text-gray-600"><%= i + 1 %></div>
        <% end %>
      </div>

      <%= form_with url: game_claim_path(game.code, my_claim.id), method: :patch,
            class: "min-w-0 portrait:mt-auto landscape:flex-1 landscape:min-h-0 landscape:overflow-x-auto transition-opacity",
            data: {"card-selection-target": "form"} do |f| %>
        <%= f.hidden_field :card_ids, value: "[]", data: {"card-selection-target": "input"} %>
        <div class="grid grid-rows-3 grid-flow-col gap-2 portrait:auto-cols-fr landscape:h-full landscape:auto-cols-max">
          <% game.board_cards.each do |card| %>
            <button type="button"
                    class="aspect-[5/7] rounded-xl transition portrait:w-full landscape:h-full"
                    aria-pressed="false"
                    data-card-selection-target="card"
                    data-card-id="<%= card.id %>"
                    data-action="click->card-selection#toggle">
              <%= render "cards/card", card: card %>
            </button>
          <% end %>
        </div>
      <% end %>

      <div class="portrait:hidden w-36 shrink-0 flex flex-col items-center justify-center gap-2 rounded-2xl bg-yellow-400 p-3 text-center text-gray-950"
           data-controller="countdown"
           data-countdown-started-at-value="<%= game.claim_started_at.iso8601 %>"
           data-countdown-duration-value="<%= Game::CLAIM_TIMEOUT %>">
        <%= render "players/controller/small_ring", size: "size-16", track: "stroke-yellow-600", stroke: "stroke-gray-950", digits: "text-2xl", duration: Game::CLAIM_TIMEOUT %>
        <p class="font-display text-xl font-bold leading-tight">Your SET!</p>
        <p class="text-sm font-medium">Tap 3 cards</p>
        <p class="font-display text-2xl font-bold tabular-nums"><span data-card-selection-target="count">0</span><span class="opacity-50">/3</span></p>
      </div>

      <%= render "players/controller/info_column", player: player %>
    </div>

  <% elsif game.claim_active? %>
    <%# Someone else is claiming. %>
    <div class="flex-1 min-h-0 flex portrait:flex-col portrait:items-center portrait:justify-center landscape:gap-3">
      <%= render "players/controller/board_strip", game: game %>
      <div class="flex flex-col items-center justify-center gap-5 text-center landscape:w-36 landscape:shrink-0 landscape:gap-2 landscape:py-2">
        <div>
          <p class="flex items-center justify-center gap-2 font-display text-4xl font-bold landscape:text-xl"><span class="size-4 shrink-0 rounded-full" style="background-color: <%= game.claiming_player.color %>;"></span><%= game.claiming_player.name %></p>
          <p class="mt-1 text-lg text-yellow-400 landscape:text-xs">is calling SET!</p>
        </div>
        <div class="relative grid place-items-center portrait:size-76 landscape:w-full landscape:flex-1"
             data-controller="countdown"
             data-countdown-started-at-value="<%= game.claim_started_at.iso8601 %>"
             data-countdown-duration-value="<%= Game::CLAIM_TIMEOUT %>">
          <%= render "players/controller/button_ring", stroke: "stroke-yellow-400" %>
          <button type="button" disabled class="flex flex-col items-center justify-center cursor-not-allowed bg-gray-900 text-gray-500 <%= set_round %>">
            <span class="font-display text-5xl font-extrabold tracking-widest landscape:text-2xl">SET!</span>
            <span class="mt-2 text-sm text-yellow-400"><span data-countdown-target="display" class="tabular-nums"><%= Game::CLAIM_TIMEOUT %></span> s</span>
          </button>
        </div>
        <%= render "players/controller/secondary_action", game: game, player: player, disabled: true %>
      </div>
      <%= render "players/controller/info_column", player: player %>
    </div>

  <% elsif game.no_set_active? %>
    <% active_count = game.players.select(&:active?).size %>
    <% voted = game.no_set_voters.size %>
    <% waiting_for = [active_count - voted, 0].max %>
    <% status_box = "grid h-20 w-full place-items-center rounded-2xl border-2 border-purple-700 px-3 text-center font-semibold text-purple-200 landscape:h-auto landscape:flex-1 landscape:text-sm" %>
    <div class="flex-1 min-h-0 flex portrait:flex-col landscape:gap-3">
      <%= render "players/controller/board_strip", game: game %>
      <div class="flex flex-col portrait:flex-1 portrait:gap-4 landscape:w-36 landscape:shrink-0 landscape:gap-2">
        <div class="flex items-center gap-4 rounded-2xl bg-purple-950/60 p-4 ring-1 ring-inset ring-purple-800 landscape:flex-col landscape:gap-1 landscape:p-2 landscape:text-center"
             data-controller="countdown"
             data-countdown-started-at-value="<%= game.no_set_started_at.iso8601 %>"
             data-countdown-duration-value="15">
          <%= render "players/controller/small_ring", size: "size-16 landscape:size-12", track: "stroke-gray-700", stroke: "stroke-purple-400", digits: "text-2xl text-purple-300 landscape:text-lg", duration: 15 %>
          <div class="min-w-0">
            <p class="text-sm text-purple-300 landscape:text-xs">No Set called by</p>
            <p class="flex items-center gap-2 truncate font-display text-2xl font-bold landscape:justify-center landscape:text-base"><span class="size-3 shrink-0 rounded-full" style="background-color: <%= game.no_set_caller.color %>;"></span><%= game.no_set_caller.name %></p>
          </div>
          <p class="ml-auto text-right landscape:hidden"><span class="font-display text-3xl font-bold tabular-nums"><%= voted %></span><span class="text-gray-400">/<%= active_count %></span><span class="block text-xs uppercase tracking-widest text-gray-400">agreed</span></p>
        </div>
        <div class="mt-auto flex flex-col gap-3 landscape:mt-0 landscape:flex-1 landscape:gap-2">
          <% if game.no_set_caller == player %>
            <p class="<%= status_box %>">You called No Set · waiting for <%= waiting_for %> more</p>
          <% elsif game.no_set_voters.include?(player.id) %>
            <p class="<%= status_box %>">You agreed · waiting for <%= waiting_for %> more</p>
          <% else %>
            <%= button_to "I agree, no Set", game_no_set_path(game.code), method: :post,
                  form_class: "contents", data: {turbo_submits_with: "…"},
                  class: "h-20 w-full rounded-2xl bg-purple-600 hover:bg-purple-500 active:scale-95 transition font-display text-2xl font-bold landscape:h-auto landscape:flex-1 landscape:text-base" %>
          <% end %>
          <p class="text-center text-sm text-gray-500 landscape:hidden">Spotted one after all?</p>
          <% if locked %>
            <button type="button" disabled class="h-16 w-full cursor-not-allowed rounded-2xl bg-gray-900 font-display text-2xl font-extrabold tracking-widest text-gray-500 landscape:h-12 landscape:text-lg">SET!</button>
          <% else %>
            <%= button_to "SET!", game_claims_path(game.code), method: :post,
                  form_class: "contents", data: {turbo_submits_with: "…"},
                  class: "h-16 w-full rounded-2xl bg-blue-600 hover:bg-blue-500 active:scale-95 transition font-display text-2xl font-extrabold tracking-widest landscape:h-12 landscape:text-lg" %>
          <% end %>
        </div>
      </div>
      <%= render "players/controller/info_column", player: player %>
    </div>

  <% elsif game.playing? && locked %>
    <%# Locked out after a wrong or expired claim: SET! becomes the countdown. %>
    <div class="flex-1 min-h-0 flex rounded-3xl bg-red-950/40 animate-shake portrait:flex-col portrait:items-center portrait:justify-center landscape:gap-3">
      <%= render "players/controller/board_strip", game: game %>
      <div class="flex flex-col items-center justify-center gap-5 landscape:w-36 landscape:shrink-0 landscape:gap-2 landscape:py-2">
        <div class="text-center">
          <% if player.lockout_reason == "expired" %>
            <p class="font-display text-4xl font-bold text-red-400 landscape:text-xl">Time's up! −1</p>
            <p class="mt-1 text-red-200 landscape:text-xs">Out of time · locked for 5 s</p>
          <% else %>
            <p class="font-display text-4xl font-bold text-red-400 landscape:text-xl">Wrong! −1</p>
            <p class="mt-1 text-red-200 landscape:text-xs">Not a Set · locked for 5 s</p>
          <% end %>
        </div>
        <div class="relative grid place-items-center portrait:size-76 landscape:w-full landscape:flex-1"
             data-controller="countdown"
             data-countdown-started-at-value="<%= (player.locked_until - 5.seconds).iso8601 %>"
             data-countdown-duration-value="5">
          <%= render "players/controller/button_ring", stroke: "stroke-red-500" %>
          <button type="button" disabled class="flex flex-col items-center justify-center cursor-not-allowed bg-gray-900 text-red-400 ring-1 ring-inset ring-red-900 <%= set_round %>">
            <span data-countdown-target="display" class="font-display text-8xl font-extrabold leading-none tabular-nums landscape:text-5xl">5</span>
            <span class="mt-2 text-sm font-semibold uppercase tracking-[0.3em] text-red-300 landscape:text-xs">Locked</span>
          </button>
        </div>
        <%= render "players/controller/secondary_action", game: game, player: player %>
      </div>
      <%= render "players/controller/info_column", player: player, score_class: "text-red-400" %>
    </div>

  <% elsif game.playing? %>
    <%# Idle. %>
    <div class="flex-1 min-h-0 flex portrait:flex-col portrait:items-center portrait:justify-center landscape:gap-3">
      <%= render "players/controller/board_strip", game: game %>
      <div class="flex flex-col items-center justify-center gap-6 landscape:w-36 landscape:shrink-0 landscape:gap-3">
        <div class="grid place-items-center portrait:size-76 landscape:w-full landscape:flex-1">
          <%= button_to "SET!", game_claims_path(game.code), method: :post,
                form_class: "contents", data: {turbo_submits_with: "…"},
                class: "bg-blue-600 hover:bg-blue-500 active:scale-95 transition font-display font-extrabold tracking-widest shadow-2xl ring-8 ring-blue-500/20 portrait:text-5xl landscape:text-3xl #{set_round}" %>
        </div>
        <%= render "players/controller/secondary_action", game: game, player: player %>
      </div>
      <%= render "players/controller/info_column", player: player %>
    </div>
  <% end %>
</div>
