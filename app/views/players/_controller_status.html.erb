<%
  game = local_assigns[:game] || player.game
  flash_claim = local_assigns[:flash_claim]
  my_claim = (game.claim_player_id == player.id) ? game.claims.find_by(player: player, result: :pending) : nil
  locked = player.locked?
  # Portrait: the scoreboard, the board, the 64px status slot, then the 128px SET! slot and its pill (§8).
  set_round = "portrait:size-[104px] portrait:rounded-full landscape:size-full landscape:rounded-3xl"
  ring_round = "portrait:size-[100px] portrait:rounded-full portrait:bg-gray-800 landscape:size-full landscape:rounded-3xl landscape:bg-gray-900"
  set_idle = "bg-blue-600 hover:bg-blue-500 active:scale-95 transition font-display font-extrabold tracking-widest shadow-[0_0_36px_rgba(37,99,235,0.55)] ring-8 ring-blue-600/25 portrait:text-[30px] landscape:text-3xl #{set_round}"
  body = "flex-1 min-h-0 flex portrait:flex-col landscape:gap-3"
  column = "flex flex-col items-center portrait:h-44 portrait:shrink-0 portrait:gap-1 landscape:w-36 landscape:shrink-0 landscape:justify-center landscape:gap-2 landscape:py-2"
  slot = "relative grid shrink-0 place-items-center portrait:size-32 landscape:w-full landscape:flex-1 landscape:min-h-0"
%>
<div id="controller_status" class="relative flex-1 min-h-0 flex flex-col">
  <% if flash_claim&.correct? && flash_claim.card_ids.present? %>
    <%= render "players/controller/found_banner", claim: flash_claim %>
  <% end %>

  <% if game.waiting? || game.ended? %>
    <%= render "players/controller/header", player: player %>
  <% end %>

  <% if game.waiting? %>
    <%# Waiting: portrait stacks the roster, the invite and I'm ready; landscape and computer put the invite beside them. %>
    <% total = game.players.count %>
    <% ready_box = "h-14 w-full rounded-[14px] landscape:max-lg:h-[50px]" %>
    <div class="flex-1 min-h-0 flex flex-col gap-3.5 landscape:flex-row landscape:gap-4 lg:gap-8 lg:px-6 lg:py-4">
      <div class="portrait:contents flex min-h-0 min-w-0 flex-1 flex-col gap-2.5 lg:gap-[18px] lg:rounded-[20px] lg:border lg:border-gray-800 lg:bg-gray-900 lg:p-7">
        <div class="hidden landscape:flex h-8 shrink-0 items-center gap-2.5">
          <span class="size-3 shrink-0 rounded-full lg:size-3.5" style="background-color: <%= player.color %>;"></span>
          <span class="min-w-0 flex-1 truncate font-semibold lg:text-xl"><%= player.name %></span>
          <span class="shrink-0 font-display text-[22px] font-bold tabular-nums lg:text-[28px]"><%= player.score %></span>
        </div>
        <h2 class="font-display text-[30px] font-extrabold leading-none landscape:max-lg:text-2xl lg:text-4xl">You're in</h2>
        <%= render "players/controller/roster", game: game, player: player %>
        <%= link_to "New to Set? How to play →", how_to_play_path(return_to: game_controller_path(game.code)), class: "-my-1.5 inline-flex min-h-8 items-center self-start text-sm font-semibold text-blue-400 hover:text-blue-300" %>
        <div class="portrait:order-last portrait:mt-auto landscape:mt-auto">
          <% if total < 2 %>
            <p class="<%= ready_box %> grid place-items-center border-2 border-gray-700 px-3 text-center font-semibold text-gray-400">Waiting for more players to join…</p>
          <% elsif game.start_voters.include?(player.id) %>
            <p class="<%= ready_box %> grid place-items-center border-2 border-green-700 bg-green-700/12 px-3 text-center text-[17px] font-semibold text-green-300 landscape:max-lg:text-base lg:text-lg">Ready ✓ · waiting for <%= total - game.start_voters.size %> more</p>
          <% else %>
            <%= button_to "I'm ready", ready_game_path(game.code), method: :post,
                  form_class: "contents", data: {turbo_submits_with: "…"},
                  class: "#{ready_box} bg-green-700 hover:bg-green-800 active:scale-95 transition font-display text-[22px] font-bold text-white shadow-xl landscape:max-lg:text-xl" %>
          <% end %>
        </div>
      </div>
      <%= render "players/controller/invite", game: game, class: "shrink-0 landscape:max-lg:w-[292px] lg:w-[400px]" %>
    </div>

  <% elsif game.ended? %>
    <%# Game over: portrait stacks; landscape and computer put the summary and Play again left, the standings right. %>
    <% rank = game.rank_of(player) %>
    <% winner = game.winner %>
    <% two_col = "landscape:max-lg:grid-cols-[250px_minmax(0,1fr)] landscape:max-lg:grid-rows-[minmax(0,1fr)_auto] lg:grid-cols-[360px_minmax(0,1fr)] lg:grid-rows-[minmax(0,1fr)_auto_auto_minmax(0,1fr)] lg:gap-y-0" %>
    <div class="flex-1 min-h-0 grid grid-rows-[auto_minmax(0,1fr)_auto] gap-3 landscape:max-lg:gap-x-5 landscape:max-lg:gap-y-1.5 lg:gap-x-12 lg:px-6 lg:py-4 <%= two_col %>">
      <div class="flex min-w-0 flex-col items-center gap-1.5 text-center landscape:max-lg:col-start-1 landscape:max-lg:row-start-1 landscape:max-lg:items-stretch landscape:max-lg:text-left lg:col-start-1 lg:row-start-2 lg:items-stretch lg:text-left">
        <div class="portrait:hidden flex h-8 items-center gap-2.5">
          <span class="size-3 shrink-0 rounded-full" style="background-color: <%= player.color %>;"></span>
          <span class="min-w-0 flex-1 truncate font-semibold lg:text-xl"><%= player.name %></span>
          <span class="shrink-0 font-display text-[22px] font-bold tabular-nums lg:text-[28px]"><%= player.score %></span>
        </div>
        <p class="text-xs uppercase tracking-[0.3em] text-gray-400 landscape:max-lg:mt-1 lg:text-sm">Game over</p>
        <p data-rank class="font-display text-[64px] font-extrabold leading-none landscape:max-lg:text-6xl lg:text-[120px] lg:leading-[0.95]"><%= rank.ordinalize %></p>
        <p class="text-[15px] text-gray-400 landscape:max-lg:text-sm lg:text-lg">of <%= game.players.size %> players · <%= pluralize(player.score, "point") %></p>
        <p data-winner-line class="text-[17px] font-semibold lg:text-[22px]"><span class="text-yellow-400">★</span> <% if winner %><%= winner == player ? "You win" : "#{winner.name} wins" %> with <%= winner.score %><% else %>Tied for first at <%= game.standings.first&.score %><% end %></p>
      </div>

      <%= render "players/controller/standings", game: game, player: player, class: "landscape:max-lg:col-start-2 landscape:max-lg:row-span-2 landscape:max-lg:row-start-1 lg:col-start-2 lg:row-span-4 lg:row-start-1" %>

      <div class="landscape:max-lg:col-start-1 landscape:max-lg:row-start-2 lg:col-start-1 lg:row-start-3 lg:mt-7">
        <% if game.start_voters.include?(player.id) %>
          <p class="grid h-14 w-full place-items-center rounded-2xl border-2 border-green-700 bg-green-700/12 px-3 text-center text-[17px] font-semibold text-green-300 landscape:max-lg:h-[50px] landscape:max-lg:text-[15px] lg:h-15 lg:text-lg">Ready ✓ · waiting for <%= game.play_again_waiting_count %> more</p>
        <% else %>
          <%= button_to "Play again", ready_game_path(game.code), method: :post,
                form_class: "contents", data: {turbo_submits_with: "…"},
                class: "h-14 w-full rounded-2xl bg-green-700 hover:bg-green-800 active:scale-95 transition font-display text-[22px] font-bold shadow-xl landscape:max-lg:h-[50px] landscape:max-lg:text-xl lg:h-15 lg:text-2xl" %>
        <% end %>
      </div>
    </div>

  <% elsif my_claim %>
    <%# Claiming (mine): pick 3 cards. Portrait: the claim bar in the status slot, the tray in place of SET! and its pill. %>
    <div data-controller="card-selection" class="<%= body %>">
      <%= render "players/controller/scoreboard", game: game, player: player, class: "landscape:hidden" %>
      <%= render "players/controller/board_strip", game: game, mode: :select, claim: my_claim %>
      <%= render "players/controller/status_panel", game: game, player: player, variant: :claim, class: "landscape:hidden" %>

      <div class="landscape:hidden flex h-44 shrink-0 items-center justify-center gap-3.5">
        <% 3.times do |i| %>
          <div data-card-selection-target="slot" class="w-[72px] aspect-[5/7] grid place-items-center overflow-hidden rounded-[7px] border-2 border-dashed border-gray-700 font-display text-2xl font-bold text-gray-500"><%= i + 1 %></div>
        <% end %>
      </div>

      <div class="portrait:hidden w-36 shrink-0 flex flex-col items-center justify-center gap-2 rounded-2xl bg-yellow-400 p-3 text-center text-gray-950"
           data-controller="countdown"
           data-countdown-started-at-value="<%= game.claim_started_at.iso8601 %>"
           data-countdown-duration-value="<%= Game::CLAIM_TIMEOUT %>">
        <%= render "players/controller/small_ring", size: "size-16", track: "stroke-yellow-600", stroke: "stroke-gray-950", digits: "text-2xl", duration: Game::CLAIM_TIMEOUT %>
        <p class="font-display text-xl font-bold leading-tight">Your SET!</p>
        <p class="text-sm font-medium">Tap 3 cards</p>
        <p class="font-display text-2xl font-bold tabular-nums"><span data-card-selection-target="count">0</span><span class="opacity-50">/3</span></p>
      </div>

      <%= render "players/controller/info_column", player: player %>
    </div>

  <% elsif game.claim_active? %>
    <%# Someone else is claiming: a read-only board, the seconds inside the yellow ring. %>
    <div class="<%= body %>">
      <%= render "players/controller/scoreboard", game: game, player: player, class: "landscape:hidden" %>
      <%= render "players/controller/board_strip", game: game %>
      <%= render "players/controller/status_panel", game: game, player: player, variant: :other, class: "landscape:hidden" %>
      <div class="<%= column %>">
        <div class="portrait:hidden text-center">
          <p class="flex items-center justify-center gap-2 font-display text-xl font-bold"><span class="size-4 shrink-0 rounded-full" style="background-color: <%= game.claiming_player.color %>;"></span><%= game.claiming_player.name %></p>
          <p class="mt-1 text-xs text-yellow-400">is calling SET!</p>
        </div>
        <div class="<%= slot %>"
             data-controller="countdown"
             data-countdown-started-at-value="<%= game.claim_started_at.iso8601 %>"
             data-countdown-duration-value="<%= Game::CLAIM_TIMEOUT %>">
          <%= render "players/controller/button_ring", stroke: "stroke-yellow-400" %>
          <button type="button" disabled class="relative flex flex-col items-center justify-center cursor-not-allowed text-gray-500 <%= ring_round %>">
            <span class="font-display font-extrabold portrait:order-last portrait:font-sans portrait:text-[11px] portrait:font-semibold portrait:text-gray-400 landscape:text-2xl landscape:tracking-widest">SET!</span>
            <span class="text-yellow-400 portrait:font-display portrait:text-[38px] portrait:font-extrabold portrait:leading-none portrait:text-gray-200 landscape:mt-2 landscape:text-sm"><span data-countdown-target="display" class="tabular-nums"><%= Game::CLAIM_TIMEOUT %></span><span class="portrait:hidden"> s</span></span>
          </button>
        </div>
        <%= render "players/controller/secondary_action", game: game, player: player, disabled: true %>
      </div>
      <%= render "players/controller/info_column", player: player %>
    </div>

  <% elsif game.no_set_active? %>
    <%# No Set countdown: the status panel, then SET! in its idle slot, then the agree pill. %>
    <div class="<%= body %>">
      <%= render "players/controller/scoreboard", game: game, player: player, class: "landscape:hidden" %>
      <%= render "players/controller/board_strip", game: game %>
      <%= render "players/controller/status_panel", game: game, player: player, variant: :no_set, class: "landscape:hidden" %>
      <div class="<%= column %>">
        <div class="portrait:hidden flex w-full flex-col items-center gap-1 rounded-2xl bg-purple-950/60 p-2 text-center ring-1 ring-inset ring-purple-800"
             data-controller="countdown"
             data-countdown-started-at-value="<%= game.no_set_started_at.iso8601 %>"
             data-countdown-duration-value="15">
          <%= render "players/controller/small_ring", size: "size-12", track: "stroke-gray-700", stroke: "stroke-purple-400", digits: "text-lg text-purple-300", duration: 15 %>
          <div class="min-w-0">
            <p class="text-xs text-purple-300">No Set called by</p>
            <p class="flex items-center justify-center gap-2 truncate font-display text-base font-bold"><span class="size-3 shrink-0 rounded-full" style="background-color: <%= game.no_set_caller.color %>;"></span><%= game.no_set_caller.name %></p>
          </div>
        </div>
        <div class="<%= slot %>">
          <% if locked %>
            <button type="button" disabled class="cursor-not-allowed bg-gray-800 text-gray-500 font-display font-extrabold tracking-widest portrait:text-[30px] landscape:text-2xl <%= set_round %>">SET!</button>
          <% else %>
            <%= button_to "SET!", game_claims_path(game.code), method: :post,
                  form_class: "contents", data: {turbo_submits_with: "…"}, class: set_idle %>
          <% end %>
        </div>
        <%= render "players/controller/secondary_action", game: game, player: player %>
      </div>
      <%= render "players/controller/info_column", player: player %>
    </div>

  <% elsif game.playing? && locked %>
    <%# Locked out after a wrong or expired claim: SET! becomes the countdown. Portrait shakes the status slot. %>
    <div class="<%= body %> landscape:rounded-3xl landscape:bg-red-950/40 landscape:animate-shake">
      <%= render "players/controller/scoreboard", game: game, player: player, class: "landscape:hidden" %>
      <%= render "players/controller/board_strip", game: game %>
      <%= render "players/controller/status_panel", game: game, player: player, variant: :locked, class: "landscape:hidden" %>
      <div class="<%= column %>">
        <div class="portrait:hidden text-center">
          <% if player.lockout_reason == "expired" %>
            <p class="font-display text-xl font-bold text-red-400">Time's up! −1</p>
            <p class="mt-1 text-xs text-red-200">Out of time · locked for 5 s</p>
          <% else %>
            <p class="font-display text-xl font-bold text-red-400">Wrong! −1</p>
            <p class="mt-1 text-xs text-red-200">Not a Set · locked for 5 s</p>
          <% end %>
        </div>
        <div class="<%= slot %>"
             data-controller="countdown"
             data-countdown-started-at-value="<%= (player.locked_until - 5.seconds).iso8601 %>"
             data-countdown-duration-value="5">
          <%= render "players/controller/button_ring", stroke: "stroke-red-500" %>
          <button type="button" disabled class="relative flex flex-col items-center justify-center cursor-not-allowed text-red-400 portrait:text-gray-200 landscape:ring-1 landscape:ring-inset landscape:ring-red-900 <%= ring_round %>">
            <span data-countdown-target="display" class="font-display font-extrabold leading-none tabular-nums portrait:text-[38px] landscape:text-5xl">5</span>
            <span class="font-semibold text-red-300 portrait:text-xs portrait:font-bold landscape:mt-2 landscape:text-xs landscape:uppercase landscape:tracking-[0.3em]">Locked</span>
          </button>
        </div>
        <%= render "players/controller/secondary_action", game: game, player: player %>
      </div>
      <%= render "players/controller/info_column", player: player, score_class: "text-red-400" %>
    </div>

  <% elsif game.playing? %>
    <%# Idle: a card tap calls SET! (§8); the status slot stays empty. %>
    <div class="<%= body %>">
      <%= render "players/controller/scoreboard", game: game, player: player, class: "landscape:hidden" %>
      <%= render "players/controller/board_strip", game: game, mode: :tap %>
      <%= render "players/controller/status_panel", game: game, player: player, class: "landscape:hidden" %>
      <div class="<%= column %>">
        <div class="<%= slot %>">
          <%= button_to "SET!", game_claims_path(game.code), method: :post,
                form_class: "contents", data: {turbo_submits_with: "…"}, class: set_idle %>
        </div>
        <%= render "players/controller/secondary_action", game: game, player: player %>
      </div>
      <%= render "players/controller/info_column", player: player %>
    </div>
  <% end %>
</div>
