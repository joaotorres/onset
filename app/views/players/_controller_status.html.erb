<%
  game = local_assigns[:game] || player.game
  flash_claim = local_assigns[:flash_claim]
  my_claim = game.claim_player_id == player.id ? game.claims.find_by(player: player, result: :pending) : nil
  state_class = if my_claim
    "player-claiming"
  elsif game.no_set_active?
    "player-no-set"
  elsif game.claim_active?
    "player-claim-active"
  elsif game.playing?
    "player-idle"
  end
%>
<div id="controller_status" class="flex-1 flex flex-col<%= " #{state_class}" if state_class %>">
  <% if flash_claim&.correct? && flash_claim.card_ids.present? %>
    <div class="found-set-flash fixed top-0 left-0 right-0 z-50 bg-gray-900/95 border-b border-green-600/40 py-2 px-4 flex items-center justify-center gap-3">
      <% flash_claim.card_ids.map { |cid| Card.new(cid) }.each do |card| %>
        <div style="width: calc(4.5rem * 5 / 7); height: 4.5rem;">
          <%= render "cards/card", card: card %>
        </div>
      <% end %>
      <p class="text-green-400 text-sm font-bold ml-2"><%= flash_claim.player.name %> +1</p>
    </div>
  <% end %>

  <div class="player-status-header flex items-center justify-between mb-6">
    <div class="flex items-center gap-3">
      <span class="w-4 h-4 rounded-full inline-block" style="background-color: <%= player.color %>;"></span>
      <span class="font-semibold text-lg"><%= player.name %></span>
    </div>
    <div class="text-right">
      <p class="text-gray-400 text-xs uppercase tracking-widest">Score</p>
      <p class="text-2xl font-bold"><%= player.score %></p>
    </div>
  </div>

  <% if game.waiting? %>
    <%# Waiting lobby: player list + vote-to-start %>
    <div class="flex-1 flex flex-col px-2">
      <h2 class="text-center text-xl font-bold text-white mb-4">Waiting for players…</h2>

      <ul class="space-y-2 mb-6">
        <% game.players.each do |p| %>
          <li class="flex items-center gap-3 px-3 py-2 bg-gray-800 rounded-xl">
            <span class="w-3 h-3 rounded-full flex-shrink-0" style="background-color: <%= p.color %>;"></span>
            <span class="text-white font-medium text-sm"><%= p.name %></span>
            <% if game.start_voters.include?(p.id) %>
              <span class="ml-auto text-green-400 text-xs font-semibold">Ready ✓</span>
            <% end %>
          </li>
        <% end %>
      </ul>

      <% already_voted = game.start_voters.include?(player.id) %>
      <% total = game.players.count %>
      <% voted = game.start_voters.size %>
      <% if total < 2 %>
        <p class="text-center text-gray-500 text-sm">Waiting for more players to join…</p>
      <% elsif already_voted %>
        <p class="text-center text-green-400 font-semibold mb-3">You're ready!</p>
        <p class="text-center text-gray-400 text-sm">Waiting for others… (<%= voted %>/<%= total %>)</p>
      <% else %>
        <%= button_to "Start Game", ready_game_path(game.code), method: :post,
              data: {"turbo-submits-with": "…"},
              class: "w-full py-4 rounded-2xl bg-green-600 hover:bg-green-500 active:scale-95 text-white font-bold text-xl transition-all shadow-xl mb-2" %>
        <% if voted > 0 %>
          <p class="text-center text-gray-400 text-sm"><%= voted %>/<%= total %> ready</p>
        <% end %>
      <% end %>
    </div>

  <% elsif game.ended? %>
    <%# Game over state %>
    <div class="flex-1 flex items-center justify-center">
      <div class="text-center">
        <p class="text-3xl font-bold text-white mb-2">Game Over</p>
        <p class="text-gray-400 text-lg">Final score:</p>
        <p class="text-5xl font-bold text-white mt-1"><%= player.score %></p>
      </div>
    </div>

  <% elsif my_claim %>
    <%# State 2: claim active — mine. Show card grid with countdown ring. %>

    <%# Portrait-only countdown bar (hidden in landscape via CSS) %>
    <div class="player-claim-portrait-bar flex items-center gap-3 mb-3"
         data-controller="countdown"
         data-countdown-started-at-value="<%= game.claim_started_at.iso8601 %>"
         data-countdown-duration-value="<%= Game::CLAIM_TIMEOUT %>">
      <svg class="w-8 h-8 flex-shrink-0 -rotate-90" viewBox="0 0 100 100">
        <circle cx="50" cy="50" r="45" fill="none" stroke="#374151" stroke-width="8"/>
        <circle cx="50" cy="50" r="45" fill="none" stroke="#FBBF24" stroke-width="8"
                stroke-dasharray="<%= (2 * Math::PI * 45).round(1) %>"
                stroke-linecap="round"
                data-countdown-target="ring"/>
      </svg>
      <span class="text-xl font-bold text-yellow-400" data-countdown-target="display"><%= Game::CLAIM_TIMEOUT %></span>
      <span class="text-gray-400 text-sm">s</span>
      <p class="text-yellow-400 font-semibold text-sm ml-1">Pick 3 cards — tap to select</p>
    </div>

    <%# In landscape: flex-row with card grid on left and info panel on right %>
    <div class="player-claim-content">
      <%= form_with url: game_claim_path(game.code, my_claim.id), method: :patch,
            data: {controller: "card-selection", "card-selection-target": "form"} do |f| %>
        <%= f.hidden_field :card_ids, value: "[]",
              data: {"card-selection-target": "input"} %>

        <div class="player-card-overflow overflow-x-auto -mx-4 px-4">
          <div class="player-card-grid grid grid-flow-col gap-2">
            <% game.board_cards.each do |card| %>
              <div class="cursor-pointer rounded-xl transition-all"
                   data-card-selection-target="card"
                   data-card-id="<%= card.id %>"
                   data-action="click->card-selection#toggle">
                <%= render "cards/card", card: card %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# Landscape-only middle panel: action buttons %>
      <div class="player-claim-button-panel">
        <%= button_to "SET!", game_claims_path(game.code), method: :post,
              disabled: true,
              class: "player-claim-set-btn w-full py-3 rounded-2xl bg-gray-700 cursor-not-allowed opacity-50 text-white font-bold tracking-widest transition-all duration-300 shadow" %>
        <%= button_to "No Set", game_no_set_path(game.code), method: :post,
              disabled: true,
              class: "player-claim-noset-btn w-full py-2 rounded-2xl bg-gray-700 cursor-not-allowed opacity-50 text-gray-300 font-semibold transition-all shadow" %>
      </div>

      <%# Landscape-only right panel: player info + countdown %>
      <div class="player-claim-side-panel">
        <div class="flex items-center gap-1.5 max-w-full">
          <span class="w-3 h-3 rounded-full flex-shrink-0" style="background-color: <%= player.color %>;"></span>
          <span class="font-semibold text-sm truncate"><%= player.name %></span>
        </div>
        <div class="text-center">
          <p class="text-gray-400 text-xs uppercase tracking-wide">Score</p>
          <p class="text-2xl font-bold"><%= player.score %></p>
        </div>
        <div class="flex flex-col items-center gap-1"
             data-controller="countdown"
             data-countdown-started-at-value="<%= game.claim_started_at.iso8601 %>"
             data-countdown-duration-value="<%= Game::CLAIM_TIMEOUT %>">
          <svg class="w-10 h-10 -rotate-90" viewBox="0 0 100 100">
            <circle cx="50" cy="50" r="45" fill="none" stroke="#374151" stroke-width="8"/>
            <circle cx="50" cy="50" r="45" fill="none" stroke="#FBBF24" stroke-width="8"
                    stroke-dasharray="<%= (2 * Math::PI * 45).round(1) %>"
                    stroke-linecap="round"
                    data-countdown-target="ring"/>
          </svg>
          <span class="text-xl font-bold text-yellow-400" data-countdown-target="display"><%= Game::CLAIM_TIMEOUT %></span>
        </div>
        <p class="text-yellow-400 text-xs text-center font-semibold">Pick 3<br>cards</p>
      </div>
    </div>

  <% elsif game.claim_active? %>
    <%# State 3: claim active — someone else's %>

    <%# Landscape-only: read-only board cards (left column) %>
    <div class="player-idle-board">
      <div class="player-card-grid grid grid-flow-col gap-2">
        <% game.board_cards.each do |card| %>
          <div><%= render "cards/card", card: card %></div>
        <% end %>
      </div>
    </div>

    <%# Middle: portrait=centered message, landscape=disabled SET! column %>
    <div class="player-claim-active-actions flex-1 flex flex-col items-center justify-center gap-6">
      <%# Portrait-only: who's claiming + countdown %>
      <div class="player-claim-active-portrait-info text-center"
           data-controller="countdown"
           data-countdown-started-at-value="<%= game.claim_started_at.iso8601 %>"
           data-countdown-duration-value="<%= Game::CLAIM_TIMEOUT %>">
        <p class="text-2xl font-bold text-yellow-400 mb-2"><%= game.claiming_player.name %> is calling SET!</p>
        <p class="text-gray-400 text-xl"><span data-countdown-target="display"><%= Game::CLAIM_TIMEOUT %></span>…</p>
      </div>

      <%# Landscape-only: both buttons disabled while someone is picking %>
      <div class="player-claim-active-set-wrap">
        <%= button_to "SET!", game_claims_path(game.code), method: :post,
              disabled: true,
              class: "player-claim-active-set-btn w-full py-3 rounded-2xl bg-gray-700 cursor-not-allowed opacity-50 text-white font-bold tracking-widest transition-all duration-300 shadow" %>
        <%= button_to "No Set", game_no_set_path(game.code), method: :post,
              disabled: true,
              class: "w-full py-2 rounded-2xl bg-gray-700 cursor-not-allowed opacity-50 text-gray-300 font-semibold transition-all shadow" %>
      </div>
    </div>

    <%# Landscape-only: info panel (right column) %>
    <div class="player-claim-active-info">
      <div class="flex items-center gap-1.5">
        <span class="w-3 h-3 rounded-full flex-shrink-0" style="background-color: <%= player.color %>;"></span>
        <span class="font-semibold text-sm truncate"><%= player.name %></span>
      </div>
      <div class="text-center">
        <p class="text-gray-400 text-xs uppercase tracking-wide">Score</p>
        <p class="text-2xl font-bold"><%= player.score %></p>
      </div>
      <div class="text-center">
        <p class="text-yellow-400 text-xs font-semibold truncate"><%= game.claiming_player.name %></p>
        <p class="text-gray-400 text-xs">is calling SET!</p>
      </div>
      <div class="flex flex-col items-center gap-1"
           data-controller="countdown"
           data-countdown-started-at-value="<%= game.claim_started_at.iso8601 %>"
           data-countdown-duration-value="<%= Game::CLAIM_TIMEOUT %>">
        <svg class="w-10 h-10 -rotate-90" viewBox="0 0 100 100">
          <circle cx="50" cy="50" r="45" fill="none" stroke="#374151" stroke-width="8"/>
          <circle cx="50" cy="50" r="45" fill="none" stroke="#FBBF24" stroke-width="8"
                  stroke-dasharray="<%= (2 * Math::PI * 45).round(1) %>"
                  stroke-linecap="round"
                  data-countdown-target="ring"/>
        </svg>
        <span class="text-xl font-bold text-yellow-400" data-countdown-target="display"><%= Game::CLAIM_TIMEOUT %></span>
      </div>
    </div>

  <% elsif game.no_set_active? %>
    <%# State 4: No-Set countdown %>

    <%# Landscape-only: read-only board cards (left column) %>
    <div class="player-idle-board">
      <div class="player-card-grid grid grid-flow-col gap-2">
        <% game.board_cards.each do |card| %>
          <div><%= render "cards/card", card: card %></div>
        <% end %>
      </div>
    </div>

    <%# Action buttons: portrait=centered column, landscape=fixed middle column %>
    <div class="player-no-set-actions flex-1 flex flex-col items-center justify-center gap-6">
      <%= button_to "SET!", game_claims_path(game.code), method: :post,
            disabled: player.locked?,
            data: {"turbo-submits-with": "Claiming…"},
            class: "player-no-set-set-btn w-40 h-16 rounded-full text-white font-bold tracking-widest transition-all duration-300 shadow #{player.locked? ? "bg-gray-700 cursor-not-allowed opacity-50" : "bg-blue-600 hover:bg-blue-500 active:scale-95"}" %>

      <%# Portrait-only: caller info + countdown (moved to right panel in landscape) %>
      <div class="player-no-set-portrait-info text-center"
           data-controller="countdown"
           data-countdown-started-at-value="<%= game.no_set_started_at.iso8601 %>"
           data-countdown-duration-value="15">
        <p class="text-purple-400 font-semibold text-lg mb-1">No Set called by</p>
        <p class="text-white font-bold text-2xl mb-4"><%= game.no_set_caller.name %></p>
        <div class="flex items-center justify-center gap-2">
          <svg class="w-10 h-10 -rotate-90" viewBox="0 0 100 100">
            <circle cx="50" cy="50" r="45" fill="none" stroke="#374151" stroke-width="8"/>
            <circle cx="50" cy="50" r="45" fill="none" stroke="#A855F7" stroke-width="8"
                    stroke-dasharray="<%= (2 * Math::PI * 45).round(1) %>"
                    stroke-linecap="round"
                    data-countdown-target="ring"/>
          </svg>
          <span class="text-2xl font-bold text-purple-400" data-countdown-target="display">15</span>
          <span class="text-gray-400">s</span>
        </div>
      </div>

      <% already_voted = game.no_set_voters.include?(player.id) %>
      <% if game.no_set_caller == player %>
        <p class="text-purple-400 font-semibold">You called 'No Set'</p>
      <% elsif already_voted %>
        <p class="text-green-400 font-semibold">You agreed — waiting for others…</p>
      <% else %>
        <%= button_to "I agree — No Set", game_no_set_path(game.code), method: :post,
              data: {"turbo-submits-with": "Joined…"},
              class: "player-no-set-agree-btn w-56 py-4 rounded-2xl bg-purple-600 hover:bg-purple-500 active:scale-95 text-white font-bold text-lg transition-all shadow-xl" %>
      <% end %>
    </div>

    <%# Landscape-only: info panel (right column) %>
    <div class="player-no-set-info">
      <div class="flex items-center gap-1.5">
        <span class="w-3 h-3 rounded-full flex-shrink-0" style="background-color: <%= player.color %>;"></span>
        <span class="font-semibold text-sm truncate"><%= player.name %></span>
      </div>
      <div class="text-center">
        <p class="text-gray-400 text-xs uppercase tracking-wide">Score</p>
        <p class="text-2xl font-bold"><%= player.score %></p>
      </div>
      <div class="text-center">
        <p class="text-purple-400 text-xs font-semibold">No Set by</p>
        <p class="text-white text-sm font-bold truncate"><%= game.no_set_caller.name %></p>
      </div>
      <div class="flex flex-col items-center gap-1"
           data-controller="countdown"
           data-countdown-started-at-value="<%= game.no_set_started_at.iso8601 %>"
           data-countdown-duration-value="15">
        <svg class="w-10 h-10 -rotate-90" viewBox="0 0 100 100">
          <circle cx="50" cy="50" r="45" fill="none" stroke="#374151" stroke-width="8"/>
          <circle cx="50" cy="50" r="45" fill="none" stroke="#A855F7" stroke-width="8"
                  stroke-dasharray="<%= (2 * Math::PI * 45).round(1) %>"
                  stroke-linecap="round"
                  data-countdown-target="ring"/>
        </svg>
        <span class="text-xl font-bold text-purple-400" data-countdown-target="display">15</span>
      </div>
    </div>

  <% elsif game.playing? %>
    <%# State 1: idle — landscape: board + buttons + info; portrait: buttons only %>

    <%# Landscape-only: read-only board cards (left column) %>
    <div class="player-idle-board">
      <div class="player-card-grid grid grid-flow-col gap-2">
        <% game.board_cards.each do |card| %>
          <div><%= render "cards/card", card: card %></div>
        <% end %>
      </div>
    </div>

    <%# Action buttons: portrait=centered column, landscape=fixed middle column %>
    <div class="player-idle-actions flex-1 flex flex-col items-center justify-center gap-6">
      <% if player.locked? %>
        <div class="text-center"
             data-controller="countdown"
             data-countdown-started-at-value="<%= (player.locked_until - 5.seconds).iso8601 %>"
             data-countdown-duration-value="5">
          <p class="text-red-400 font-semibold mb-3">Locked out</p>
          <div class="flex items-center justify-center gap-2">
            <svg class="w-10 h-10 -rotate-90" viewBox="0 0 100 100">
              <circle cx="50" cy="50" r="45" fill="none" stroke="#374151" stroke-width="8"/>
              <circle cx="50" cy="50" r="45" fill="none" stroke="#EF4444" stroke-width="8"
                      stroke-dasharray="<%= (2 * Math::PI * 45).round(1) %>"
                      stroke-linecap="round"
                      data-countdown-target="ring"/>
            </svg>
            <span class="text-2xl font-bold text-red-400" data-countdown-target="display">5</span>
            <span class="text-gray-400">s</span>
          </div>
        </div>
      <% end %>

      <%= button_to "SET!", game_claims_path(game.code), method: :post,
            disabled: player.locked?,
            data: {"turbo-submits-with": "Claiming…"},
            class: "player-idle-set-btn w-64 h-64 rounded-full text-white text-4xl font-bold tracking-widest transition-all duration-300 shadow-2xl #{player.locked? ? "bg-gray-700 cursor-not-allowed opacity-50" : "bg-blue-600 hover:bg-blue-500 active:scale-95"}" %>

      <% if game.deck.empty? %>
        <% already_voted = game.end_game_voters.include?(player.id) %>
        <% active_count = game.players.select(&:active?).count %>
        <% if already_voted %>
          <p class="text-orange-400 font-semibold text-sm">Voted to end (<%= game.end_game_voters.size %>/<%= active_count %>)</p>
        <% else %>
          <%= button_to "End Game", game_end_game_path(game.code), method: :post,
                data: {"turbo-submits-with": "…"},
                class: "player-idle-noset-btn w-40 py-3 rounded-2xl bg-orange-700 hover:bg-orange-600 active:scale-95 text-white font-semibold transition-all shadow" %>
          <% if game.end_game_voters.any? %>
            <p class="text-gray-500 text-xs"><%= game.end_game_voters.size %>/<%= active_count %> voted</p>
          <% end %>
        <% end %>
      <% else %>
        <%= button_to "No Set", game_no_set_path(game.code), method: :post,
              data: {"turbo-submits-with": "…"},
              class: "player-idle-noset-btn w-40 py-3 rounded-2xl bg-red-900 hover:bg-red-800 active:scale-95 text-red-200 font-semibold transition-all shadow" %>
      <% end %>
    </div>

    <%# Landscape-only: player info (right column) %>
    <div class="player-idle-info">
      <div class="flex items-center gap-1.5">
        <span class="w-3 h-3 rounded-full flex-shrink-0" style="background-color: <%= player.color %>;"></span>
        <span class="font-semibold text-sm truncate"><%= player.name %></span>
      </div>
      <div class="text-center">
        <p class="text-gray-400 text-xs uppercase tracking-wide">Score</p>
        <p class="text-2xl font-bold"><%= player.score %></p>
      </div>
    </div>

  <% else %>
    <div class="flex-1 flex items-center justify-center">
      <p class="text-gray-500 italic">Waiting for the game to start…</p>
    </div>
  <% end %>
</div>
