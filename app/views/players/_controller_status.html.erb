<%
  game = player.game
  my_claim = game.claim_player_id == player.id ? game.claims.find_by(player: player, result: :pending) : nil
%>
<div id="controller_status" class="flex-1 flex flex-col">
  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-3">
      <span class="w-4 h-4 rounded-full inline-block" style="background-color: <%= player.color %>;"></span>
      <span class="font-semibold text-lg"><%= player.name %></span>
    </div>
    <div class="text-right">
      <p class="text-gray-400 text-xs uppercase tracking-widest">Score</p>
      <p class="text-2xl font-bold"><%= player.score %></p>
    </div>
  </div>

  <% if my_claim %>
    <%# State 2: claim active — mine. Show card grid with countdown ring. %>
    <div class="mb-4 text-center"
         data-controller="countdown"
         data-countdown-started-at-value="<%= game.claim_started_at.iso8601 %>"
         data-countdown-duration-value="5">
      <p class="text-yellow-400 font-semibold mb-2">Pick 3 cards — tap to select</p>
      <div class="flex items-center justify-center gap-2">
        <svg class="w-10 h-10 -rotate-90" viewBox="0 0 100 100">
          <circle cx="50" cy="50" r="45" fill="none" stroke="#374151" stroke-width="8"/>
          <circle cx="50" cy="50" r="45" fill="none" stroke="#FBBF24" stroke-width="8"
                  stroke-dasharray="<%= (2 * Math::PI * 45).round(1) %>"
                  stroke-linecap="round"
                  data-countdown-target="ring"/>
        </svg>
        <span class="text-2xl font-bold text-yellow-400" data-countdown-target="display">5</span>
        <span class="text-gray-400">s</span>
      </div>
    </div>

    <%= form_with url: game_claim_path(game.code, my_claim.id), method: :patch,
          data: {controller: "card-selection", "card-selection-target": "form"} do |f| %>
      <%= f.hidden_field :card_ids, value: "[]",
            data: {"card-selection-target": "input"} %>

      <div class="grid grid-cols-4 gap-2">
        <% game.board_cards.each do |card| %>
          <div class="aspect-[5/7] cursor-pointer rounded-xl transition-all"
               data-controller-target="card"
               data-card-id="<%= card.id %>"
               data-action="click->card-selection#toggle">
            <%= render "cards/card", card: card %>
          </div>
        <% end %>
      </div>
    <% end %>

  <% elsif game.claim_active? %>
    <%# State 3: claim active — someone else's %>
    <div class="flex-1 flex items-center justify-center"
         data-controller="countdown"
         data-countdown-started-at-value="<%= game.claim_started_at.iso8601 %>"
         data-countdown-duration-value="5">
      <div class="text-center">
        <p class="text-2xl font-bold text-yellow-400 mb-2">
          <%= game.claiming_player.name %> is calling SET!
        </p>
        <p class="text-gray-400 text-xl">
          <span data-countdown-target="display">5</span>…
        </p>
      </div>
    </div>

  <% elsif game.playing? %>
    <%# State 1: idle %>
    <div class="flex-1 flex flex-col items-center justify-center gap-6">
      <%= button_to "SET!", game_claims_path(game.code), method: :post,
            disabled: player.locked?,
            class: "w-64 h-64 rounded-full text-white text-4xl font-bold tracking-widest transition-all shadow-2xl #{player.locked? ? "bg-gray-700 cursor-not-allowed" : "bg-blue-600 hover:bg-blue-500 active:scale-95"}" %>

      <% if player.locked? %>
        <p class="text-red-400 text-sm">Locked out — wait a moment</p>
      <% end %>
    </div>

  <% else %>
    <div class="flex-1 flex items-center justify-center">
      <p class="text-gray-500 italic">Waiting for the game to start…</p>
    </div>
  <% end %>
</div>
