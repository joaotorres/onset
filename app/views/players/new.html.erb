<main class="grow bg-gray-950 text-white px-5 pt-10 pb-6 flex flex-col">
  <div class="w-full max-w-sm mx-auto flex-1 flex flex-col">
    <p class="text-center text-[0.9375rem] text-gray-400">Joining room</p>
    <p class="mt-0.5 text-center font-display text-6xl font-extrabold leading-none tracking-[0.08em]"><%= @game.code %></p>

    <% base_errors = [flash[:alert], *@player.errors.full_messages_for(:base), *@player.errors.full_messages_for(:session_token)].compact %>
    <% base_errors << "This room is full" if full? %>
    <% if base_errors.uniq.any? %>
      <div role="alert" class="mt-6 rounded-xl border border-red-700 bg-red-950 px-3.5 py-3 text-[0.9375rem] font-medium text-red-200"><%= base_errors.uniq.to_sentence %></div>
    <% end %>

    <%= form_with model: [@game, @player], url: game_players_path(@game.code), class: "mt-10 flex-1 flex flex-col gap-8" do |f| %>
      <% name_errors = @player.errors.full_messages_for(:name) %>
      <div>
        <%= f.label :name, "Your name", class: "mb-2 block text-sm font-medium text-gray-300" %>
        <%= f.text_field :name,
              maxlength: 20,
              autofocus: true,
              autocomplete: "nickname",
              placeholder: "Enter your name",
              aria: name_errors.any? ? {invalid: true, describedby: "player_name_error"} : {},
              class: "h-14 w-full rounded-xl border bg-gray-900 px-4 text-xl placeholder-gray-500 focus:border-transparent focus:outline-none focus:ring-2 #{name_errors.any? ? "border-red-500 focus:ring-red-500" : "border-gray-700 focus:ring-blue-500"}" %>
        <% if name_errors.any? %>
          <p id="player_name_error" class="mt-2 text-sm text-red-400"><%= name_errors.to_sentence %></p>
        <% end %>
      </div>

      <fieldset>
        <legend class="mb-3 text-sm font-medium text-gray-300">Pick a color</legend>
        <div class="grid grid-cols-4 gap-3">
          <% PlayersController::PRESET_COLORS.each_with_index do |hex, i| %>
            <% owner = @color_owners[hex] %>
            <% if owner %>
              <label class="h-14 grid place-items-center cursor-not-allowed rounded-xl" style="background-color: color-mix(in srgb, <%= hex %> 30%, var(--color-gray-950));" title="Taken by <%= owner.name %>">
                <%= f.radio_button :color, hex, id: "color_#{i}", disabled: true, class: "sr-only" %>
                <span class="font-display text-xl font-bold text-gray-300"><%= owner.name.first.upcase %></span>
              </label>
            <% else %>
              <label class="group h-14 grid place-items-center cursor-pointer rounded-xl has-checked:ring-3 has-checked:ring-white has-checked:ring-offset-3 has-checked:ring-offset-gray-950" style="background-color: <%= hex %>;">
                <%= f.radio_button :color, hex, id: "color_#{i}", class: "sr-only" %>
                <span class="hidden text-2xl font-bold text-white group-has-checked:block">✓</span>
              </label>
            <% end %>
          <% end %>
        </div>
        <% color_errors = @player.errors.full_messages_for(:color) %>
        <% if color_errors.any? %>
          <p class="mt-3 text-sm text-red-400"><%= color_errors.to_sentence %></p>
        <% elsif @color_owners.any? %>
          <p class="mt-3 text-sm text-gray-500">Faded colors are taken. The letter shows by whom.</p>
        <% end %>
      </fieldset>

      <div class="mt-auto flex flex-col gap-3.5">
        <% if full? %>
          <%= f.submit "Join", disabled: true, class: "h-14 w-full cursor-not-allowed rounded-2xl bg-gray-800 font-display text-[1.375rem] font-bold text-gray-500" %>
        <% else %>
          <%= f.submit "Join", class: "h-14 w-full cursor-pointer rounded-2xl bg-blue-600 hover:bg-blue-500 active:scale-95 transition font-display text-[1.375rem] font-bold" %>
        <% end %>
        <% if creator? %>
          <%= link_to "Use this screen as the big screen instead", game_path(@game.code), class: "self-center px-1 py-1.5 text-[0.9375rem] text-blue-300 underline underline-offset-3 hover:text-blue-200" %>
        <% end %>
      </div>
    <% end %>
  </div>
</main>
